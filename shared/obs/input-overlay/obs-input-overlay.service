[Unit]
Description=OBS keyboard and mouse input overlay bridge
After=default.target

[Service]
Type=simple
ExecStart=%h/.local/bin/obs-input-overlay
Restart=always
RestartSec=1
Environment=PYTHONUNBUFFERED=1
RuntimeDirectory=obs-input-overlay
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=default.target
