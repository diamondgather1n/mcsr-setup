on_force_close "quit"
session_serialization false
mouse_mode true
copy_command "wl-copy"
copy_clipboard "system"
copy_on_select true
pane_frames true
simplified_ui false
show_startup_tips false
show_release_notes false
support_kitty_keyboard_protocol true

env {
    EDITOR "micro"
    VISUAL "micro"
}

keybinds {
    // Keep Readline and editor keys available in the normal terminal mode.
    normal clear-defaults=true {
        bind "Ctrl Shift t" { NewTab; }
        bind "Ctrl Shift w" { CloseTab; }
        bind "Ctrl Tab" "Ctrl PageDown" { GoToNextTab; }
        bind "Ctrl Shift Tab" "Ctrl PageUp" { GoToPreviousTab; }
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }
        bind "Ctrl Shift f" { SearchInput 0; SwitchToMode "EnterSearch"; }
        bind "Ctrl Shift e" { EditScrollback; }
        bind "Shift PageUp" { PageScrollUp; SwitchToMode "Scroll"; }
        bind "Shift PageDown" { PageScrollDown; SwitchToMode "Scroll"; }
        bind "Ctrl Shift Space" { SwitchToMode "Session"; }
        bind "Ctrl Shift Right" { NewPane "Right"; }
        bind "Ctrl Shift Down" { NewPane "Down"; }
        bind "Alt Left" { MoveFocus "Left"; }
        bind "Alt Right" { MoveFocus "Right"; }
        bind "Alt Up" { MoveFocus "Up"; }
        bind "Alt Down" { MoveFocus "Down"; }
        bind "Ctrl Shift y" {
            NewTab {
                name "Files"
                layout "@HOME@/.config/zellij/layouts/yazi-dual.kdl"
            }
        }
    }
    scroll {
        bind "Shift PageUp" { PageScrollUp; }
        bind "Shift PageDown" { PageScrollDown; }
        bind "Esc" "Enter" { ScrollToBottom; SwitchToMode "Normal"; }
    }
    entersearch {
        bind "Esc" "Ctrl c" { ScrollToBottom; SwitchToMode "Normal"; }
    }
    search {
        bind "Esc" "Enter" { ScrollToBottom; SwitchToMode "Normal"; }
    }
}
