#!/usr/bin/env bash
set -Eeuo pipefail

TARGET_HOME="@HOME@"
TARGET_USER="@USER@"
STATE_ROOT="$TARGET_HOME/DoOvers/state"
CONFIG="$TARGET_HOME/.config/jay/config.toml"

[[ "$(id -un)" == "$TARGET_USER" && "$EUID" -ne 0 ]] || {
    printf 'Run this as %s, without sudo.\n' "$TARGET_USER" >&2
    exit 2
}

state_id=$(<"$STATE_ROOT/latest")
[[ "$state_id" =~ ^[A-Za-z0-9._-]+$ ]] || { printf 'Invalid rollback state id.\n' >&2; exit 1; }
state="$STATE_ROOT/$state_id"
[[ -d "$state" && ! -L "$state" ]] || { printf 'Rollback state is missing.\n' >&2; exit 1; }

runtime_fingerprint() {
    local path=$1
    if [[ -L "$path" ]]; then printf 'link:%s' "$(readlink -- "$path")"
    elif [[ -f "$path" ]]; then printf 'file:%s' "$(sha256sum -- "$path" | cut -d' ' -f1)"
    elif [[ -d "$path" ]]; then printf 'dir:%s' "$(stat -c '%u:%g:%a' -- "$path")"
    else printf missing
    fi
}

update_after_fingerprint() {
    local target=$1 fingerprint=$2 tmp i
    local -a records
    mapfile -d '' -t records <"$state/files.after"
    tmp=$(mktemp "$state/.files.after.XXXXXX")
    for ((i=0; i+1<${#records[@]}; i+=2)); do
        if [[ "${records[i]}" == "$target" ]]; then records[i+1]=$fingerprint; fi
        printf '%s\0%s\0' "${records[i]}" "${records[i+1]}" >>"$tmp"
    done
    chmod 600 "$tmp"
    mv -- "$tmp" "$state/files.after"
}

is_installer_created_file() {
    local target=$1 i
    local -a records
    mapfile -d '' -t records <"$state/files.before"
    for ((i=0; i+2<${#records[@]}; i+=3)); do
        if [[ "${records[i]}" == "$target" && "${records[i+1]}" == user:new-file ]]; then
            return 0
        fi
    done
    return 1
}

remove_added_package_record() {
    local tmp
    tmp=$(mktemp "$state/.packages.added.XXXXXX")
    grep -vxF waybar "$state/packages.added" >"$tmp" || :
    chmod 600 "$tmp"
    mv -- "$tmp" "$state/packages.added"
}

pkill -x waybar 2>/dev/null || :

if python3 - "$CONFIG" <<'PY'
import os
import pathlib
import sys
import tempfile

path = pathlib.Path(sys.argv[1])
marker = "# MCSR_SETUP_WAYBAR_START"
if not path.is_file():
    print(f"Jay config not found; left unchanged: {path}")
    raise SystemExit(10)
lines = path.read_text().splitlines(keepends=True)
found = [i for i, line in enumerate(lines) if marker in line]
if not found:
    print("Waybar startup marker is already absent.")
    raise SystemExit(10)
elif len(found) != 1 or 'exec = ["waybar"]' not in lines[found[0]]:
    raise SystemExit("Refusing to alter an unexpected Jay line carrying the Waybar marker.")
else:
    mode = path.stat().st_mode & 0o777
    lines.pop(found[0])
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=".config.toml.")
    try:
        with os.fdopen(fd, "w") as stream:
            stream.writelines(lines)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)
    print("Removed only the marked Waybar startup entry from Jay.")
PY
then
    if is_installer_created_file "$CONFIG"; then
        update_after_fingerprint "$CONFIG" "$(runtime_fingerprint "$CONFIG")"
    fi
else
    status=$?
    [[ "$status" == 10 ]] || exit "$status"
fi

if [[ -r "$state/waybar.sha256" ]]; then
    readarray -t expected <"$state/waybar.sha256"
    for index in 0 1; do
        file="$TARGET_HOME/.config/waybar/$([[ "$index" == 0 ]] && printf config || printf style.css)"
        if [[ -f "$file" ]] && [[ "$(sha256sum -- "$file" | cut -d' ' -f1)" == "${expected[$index]}" ]] \
            && is_installer_created_file "$file"; then
            rm -- "$file"
            printf 'Removed unchanged installer-deployed %s.\n' "${file##*/}"
            update_after_fingerprint "$file" missing
        elif [[ -f "$file" ]] && is_installer_created_file "$file"; then
            printf 'Kept user-modified %s.\n' "$file"
        elif [[ -e "$file" ]]; then
            printf 'Kept pre-existing %s.\n' "$file"
        fi
    done
    if rmdir "$TARGET_HOME/.config/waybar" 2>/dev/null; then
        update_after_fingerprint "$TARGET_HOME/.config/waybar" missing
    else
        update_after_fingerprint "$TARGET_HOME/.config/waybar" "$(runtime_fingerprint "$TARGET_HOME/.config/waybar")"
    fi
else
    printf 'No Waybar config fingerprint is recorded; configuration was left untouched.\n'
fi

if ! pacman -Qq waybar >/dev/null 2>&1; then
    printf 'Waybar is not installed.\n'
elif grep -Fxq waybar "$state/packages.added"; then
    if sudo pacman -R --noconfirm waybar; then
        remove_added_package_record
    else
        printf 'Waybar remains installed because pacman refused safe removal.\n' >&2
    fi
else
    printf 'Waybar was present before setup or its install state is unknown; package left installed.\n'
fi
