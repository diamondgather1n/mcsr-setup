#!/usr/bin/env bash
set -euo pipefail

jar="$(
  find /home/nathan/MCSR/CrossDisplayManager -type f -iname '*mcsr*launcher*.jar' 2>/dev/null \
  | grep -vi 'updater' \
  | sort -V \
  | tail -n 1
)"

if [ -z "${jar:-}" ]; then
  echo "No MCSR Launcher jar found under /home/nathan/MCSR/CrossDisplayManager"
  exit 1
fi

cd "$HOME"
exec java -jar "$jar"
