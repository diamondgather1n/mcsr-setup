{
    "layer": "top",
    "position": "top",
    "height": 26,
    "modules-left": [
        "wayland/workspaces"
    ],
    "modules-center": [],
    "modules-right": [
        "pulseaudio",
        "cpu",
        "memory",
        "disk",
        "network",
        "clock",
        "tray"
    ],

    "pulseaudio": {
        "format": "VOL {volume}%"
    },
    "cpu": {
        "format": "CPU {usage}%",
        "interval": 1
    },
    "memory": {
        "format": "RAM {used:0.1f}/{total:0.1f}G",
        "interval": 2
    },
    "disk": {
        "path": "/",
        "format": "DISK {free} free",
        "interval": 30
    },
    "network": {
        "format-wifi": "NET D:{bandwidthDownBytes} U:{bandwidthUpBytes}",
        "format-ethernet": "NET D:{bandwidthDownBytes} U:{bandwidthUpBytes}",
        "format-disconnected": "NET offline",
        "interval": 1
    },
    "clock": {
        "format": "{:%H:%M  %a %d %b}",
        "interval": 1
    },
    "tray": {
        "spacing": 10
    }
}
