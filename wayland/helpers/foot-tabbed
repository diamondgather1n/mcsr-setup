#!/usr/bin/env bash
set -Eeuo pipefail

export EDITOR="${EDITOR:-micro}"
export VISUAL="${VISUAL:-micro}"

# A new terminal window is outside the caller's Zellij pane/session.
unset ZELLIJ ZELLIJ_SESSION_NAME ZELLIJ_PANE_ID

# Preserve Foot's command/option interface for explicit invocations.
if (( $# > 0 )); then
  exec /usr/bin/foot "$@"
fi

if ! command -v zellij >/dev/null 2>&1; then
  exec /usr/bin/foot
fi

# Foot owns selection/paste; wheel bindings scroll this window's Zellij session.
export MCSR_TERMINAL_SESSION="foot-$$"
exec /usr/bin/foot \
  --override=mouse-bindings.scrollback-up-mouse=none \
  --override=mouse-bindings.scrollback-down-mouse=none \
  --override='mouse-bindings.pipe-visible=[sh -c '\''cat >/dev/null; exec zellij --session "$MCSR_TERMINAL_SESSION" action scroll-up'\''] BTN_WHEEL_BACK' \
  --override='mouse-bindings.pipe-visible=[sh -c '\''cat >/dev/null; exec zellij --session "$MCSR_TERMINAL_SESSION" action scroll-down'\''] BTN_WHEEL_FORWARD' \
  zellij --session "$MCSR_TERMINAL_SESSION"
