#!/usr/bin/env bash
set -Eeuo pipefail

export EDITOR="${EDITOR:-micro}"
export VISUAL="${VISUAL:-micro}"

# A new terminal window is outside the caller's Zellij pane/session.
unset ZELLIJ ZELLIJ_SESSION_NAME ZELLIJ_PANE_ID

# Preserve Foot's command/option interface for explicit invocations.
if (( $# > 0 )); then
  exec /usr/bin/foot "$@"
fi

if ! command -v zellij >/dev/null 2>&1; then
  exec /usr/bin/foot
fi

exec /usr/bin/foot zellij
