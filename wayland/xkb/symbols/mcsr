default partial alphanumeric_keys keypad_keys modifier_keys
xkb_symbols "british" {
    include "gb"
    name[Group1] = "MCSR British";

    key <AE01> { [ u, u, u, u ] };
    key <AE02> { [ b, b, b, b ] };
    key <AE03> { [ 4, 4, 4, 4 ] };
    key <AE04> { [ aring, aring, aring, aring ] };

    key <FK20> { [ u, u, u, u ] };
    key <FK21> { [ b, b, b, b ] };
    key <FK22> { [ 4, 4, 4, 4 ] };
    key <FK23> { [ aring, aring, aring, aring ] };
};

partial alphanumeric_keys keypad_keys modifier_keys
xkb_symbols "norwegian" {
    include "gb"
    name[Group1] = "MCSR Norwegian";

    // keep main controls normal
    key <ESC>  { [ Escape ] };
    key <TAB>  { [ Tab, ISO_Left_Tab ] };
    key <BKSP> { [ BackSpace ] };
    key <RTRN> { [ Return ] };
    key <LFSH> { [ Shift_L ] };
    key <RTSH> { [ Shift_R ] };
    key <LCTL> { [ Control_L ] };
    key <RCTL> { [ Control_R ] };
    key <FK03> { [ F3, F3, F3, F3 ] };
    key <SPCE> { [ space, space ] };

    // numbers row
    key <AE01> { [ VoidSymbol, VoidSymbol, u, u ] };
    key <AE02> { [ VoidSymbol, s, b, b ] };
    key <AE03> { [ s, n, 4, 4 ] };

    // q row (physical W E R T)
    key <AD02> { [ aring, aring ] };
    key <AD03> { [ l, r ] };
    key <AD04> { [ r, t ] };
    key <AD05> { [ n, VoidSymbol ] };

    // home row (physical A S D F G)
    key <AC01> { [ p, d ] };
    key <AC02> { [ i, g ] };
    key <AC03> { [ a, a ] };
    key <AC04> { [ h, h ] };
    key <AC05> { [ j, j ] };

    // bottom row (physical Z X C V B N M)
    key <AB01> { [ VoidSymbol, VoidSymbol, k, k ] };
    key <AB03> { [ v, VoidSymbol ] };
    key <AB04> { [ oslash, oslash ] };
    key <AB05> { [ b, y ] };
    key <AB06> { [ VoidSymbol, VoidSymbol ] };

    // special keys
    key <AB07> { [ m, M ] };                    // m
    key <AC07> { [ NoSymbol ] };                // j
    key <AC08> { [ NoSymbol ] };                // k
    key <AD07> { [ NoSymbol ] };                // u

    // numpad
    key <NMLK> { [ Num_Lock ] };
    key <KPDV> { [ slash, KP_Divide ] };
    key <KP7>  { [ KP_Home, KP_7, KP_Home, KP_7 ] };
    key <KP8>  { [ KP_Up, KP_8, KP_Up, KP_8 ] };
    key <KP9>  { [ KP_Prior, KP_9, KP_Prior, KP_9 ] };
    key <KP4>  { [ KP_Left, KP_4, KP_Left, KP_4 ] };
    key <KP5>  { [ KP_Begin, KP_5, KP_Begin, KP_5 ] };
    key <KP6>  { [ KP_Right, KP_6, KP_Right, KP_6 ] };
    key <KP1>  { [ KP_End, KP_1, KP_End, KP_1 ] };
    key <KP2>  { [ KP_Down, KP_2, KP_Down, KP_2 ] };
    key <KP3>  { [ KP_Next, KP_3, KP_Next, KP_3 ] };
    key <KP0>  { [ KP_Insert, KP_0, KP_Insert, KP_0 ] };

    // arrows
    key <UP>   { [ Up ] };
    key <LEFT> { [ Left ] };
    key <RGHT> { [ Right ] };
    key <DOWN> { [ Down ] };

    // unbind/remap unused keys to match the xmodmap source
    key <AE04> { [ k, v, aring, aring ] };
    key <AE05> { [ g, e ] };
    key <AE06> { [ VoidSymbol, VoidSymbol ] };
    key <AE07> { [ NoSymbol ] };
    key <AE08> { [ 9, 9 ] };
    key <AE09> { [ 0, 0 ] };
    key <AE10> { [ 0, 0 ] };
    key <AE11> { [ NoSymbol ] };
    key <AE12> { [ NoSymbol ] };

    key <AD01> { [ e, b, q, Q ] };
    key <AD06> { [ NoSymbol ] }; // y
    key <AD08> { [ NoSymbol ] }; // i
    key <AD09> { [ NoSymbol ] }; // o
    key <AD10> { [ NoSymbol ] }; // p
    key <AD11> { [ bracketleft, braceleft ] };
    key <AD12> { [ bracketright, braceright ] };

    key <AC06> { [ NoSymbol ] }; // h
    key <AC09> { [ NoSymbol ] }; // l
    key <AC10> { [ NoSymbol ] };
    key <AC11> { [ apostrophe, apostrophe, apostrophe, apostrophe ] };
    key <TLDE> { [ NoSymbol ] };
    key <BKSL> { [ NoSymbol ] };

    key <LSGT> { [ NoSymbol ] };
    key <AB08> { [ NoSymbol ] };
    key <AB09> { [ NoSymbol ] };
    key <AB10> { [ NoSymbol ] };

    key <CAPS> { [ Caps_Lock ] };
    key <KPMU> { [ NoSymbol ] };
    key <LALT> { [ Alt_L ] };
    key <SCLK> { [ NoSymbol ] };
    key <KPSU> { [ NoSymbol ] };
    key <KPAD> { [ NoSymbol ] };
    key <KPDL> { [ NoSymbol ] };
    key <LVL3> { [ NoSymbol ] };
    key <ZEHA> { [ NoSymbol ] };
    key <AB11> { [ NoSymbol ] };
    key <KATA> { [ NoSymbol ] };
    key <HIRA> { [ NoSymbol ] };
    key <HENK> { [ NoSymbol ] };
    key <HKTG> { [ NoSymbol ] };
    key <MUHE> { [ NoSymbol ] };
    key <JPCM> { [ NoSymbol ] };
    key <KPEN> { [ NoSymbol ] };
    key <PRSC> { [ NoSymbol ] };
    key <RALT> { [ NoSymbol ] };
    key <LNFD> { [ NoSymbol ] };
    key <HOME> { [ Home ] };
    key <PGUP> { [ NoSymbol ] };
    key <END>  { [ NoSymbol ] };
    key <PGDN> { [ NoSymbol ] };
    key <INS>  { [ NoSymbol ] };

    // function row you explicitly killed in xmodmap except F3
    key <FK01> { [ NoSymbol ] };
    key <FK02> { [ NoSymbol ] };
    key <FK04> { [ F4, F4, F4, F4 ] };
    key <FK05> { [ NoSymbol ] };
    key <FK06> { [ NoSymbol ] };
    key <FK07> { [ NoSymbol ] };
    key <FK08> { [ NoSymbol ] };
    key <FK09> { [ NoSymbol ] };
    key <FK10> { [ NoSymbol ] };
    key <FK11> { [ NoSymbol ] };
    key <FK12> { [ NoSymbol ] };

    // Macro keys; gameplay remaps are applied by Waywall.
    // inet(evdev) gives FK13-FK16 XF86 keysyms by default, so override
    // both the canonical names and their evdev aliases.
    key <I156> { [ u, l ] };
    key <FK13> { [ F13 ] };
    key <FK14> { [ F14 ] };
    key <FK15> { [ F15 ] };
    key <FK16> { [ F16 ] };
    key <FK17> { [ VoidSymbol, s, VoidSymbol, s ] };
    key <FK18> { [ s, n, s, n ] };
    key <FK19> { [ k, v, k, v ] };
    key <FK20> { [ g, e, g, e ] };
    key <FK21> { [ VoidSymbol, VoidSymbol, VoidSymbol, VoidSymbol ] };
    key <FK22> { [ F22, F22, F22, F22 ] };
    key <FK23> { [ F23, F23, F23, F23 ] };
    key <FK24> { [ F24, F24, F24, F24 ] };
    key <I191> { [ F13 ] };
    key <I192> { [ F14 ] };
    key <I193> { [ F15 ] };
    key <I194> { [ F16 ] };
    key <I195> { [ VoidSymbol, s, VoidSymbol, s ] };
    key <I196> { [ s, n, s, n ] };
    key <I197> { [ k, v, k, v ] };
    key <I198> { [ g, e, g, e ] };
    key <I199> { [ VoidSymbol, VoidSymbol, VoidSymbol, VoidSymbol ] };
    key <I200> { [ F22, F22, F22, F22 ] };
    key <I201> { [ F23, F23, F23, F23 ] };
    key <I202> { [ F24, F24, F24, F24 ] };
};
