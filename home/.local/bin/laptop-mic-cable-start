#!/usr/bin/env bash
set -euo pipefail

latency_ms="${1:-20}"
state_file="${XDG_RUNTIME_DIR:-/tmp}/laptop-mic-cable-loopback.module"

if [[ -s "$state_file" ]] && pactl list short modules | awk '{print $1}' | grep -Fxq "$(cat "$state_file")"; then
  echo "Cable mic loopback is already running as module $(cat "$state_file")"
  exit 0
fi

module_id="$(pactl load-module module-loopback source=@DEFAULT_SOURCE@ sink=@DEFAULT_SINK@ latency_msec="$latency_ms")"
echo "$module_id" > "$state_file"
echo "Started cable mic loopback as module $module_id"
echo "Stop it with: laptop-mic-cable-stop"
