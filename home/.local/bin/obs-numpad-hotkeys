#!/usr/bin/env python3
"""Bridge keypad hotkeys to OBS WebSocket on Wayland.

OBS's native global hotkey path does not reliably receive keypad events from
other Wayland applications. This reads the existing keyd virtual keyboard and
replays the configured OBS hotkey sequence through localhost OBS WebSocket.
"""

import asyncio
import base64
import hashlib
import json
from pathlib import Path

from evdev import InputDevice, ecodes, list_devices
from websockets.asyncio.client import connect
from websockets.exceptions import ConnectionClosed


DEVICE_NAME = "keyd virtual keyboard"
OBS_CONFIG = Path.home() / ".config/obs-studio/plugin_config/obs-websocket/config.json"
OBS_URL = "ws://127.0.0.1:4455"
RETRY_SECONDS = 2

# These are the bindings in the active Untitled OBS profile. The sequence
# keeps the profile hotkeys visible/editable while bypassing Wayland delivery.
NUMPAD_HOTKEYS = {
    ecodes.KEY_KP7: "OBS_KEY_NUM7",
    ecodes.KEY_KP5: "OBS_KEY_NUM5",
    ecodes.KEY_KP4: "OBS_KEY_NUM4",
    ecodes.KEY_KP1: "OBS_KEY_NUM1",
    ecodes.KEY_KP2: "OBS_KEY_NUM2",
    ecodes.KEY_KP9: "OBS_KEY_NUM9",
}


def find_device():
    for path in list_devices():
        device = InputDevice(path)
        if device.name == DEVICE_NAME:
            return device
        device.close()
    return None


def auth_response(password, hello_auth):
    secret = base64.b64encode(
        hashlib.sha256((password + hello_auth["salt"]).encode()).digest()
    ).decode()
    return base64.b64encode(
        hashlib.sha256((secret + hello_auth["challenge"]).encode()).digest()
    ).decode()


class ObsConnection:
    def __init__(self, websocket):
        self.websocket = websocket
        self.request_id = 0

    @classmethod
    async def open(cls):
        config = json.loads(OBS_CONFIG.read_text(encoding="utf-8"))
        websocket = await connect(OBS_URL, open_timeout=2, close_timeout=1)
        hello = json.loads(await websocket.recv())
        hello_data = hello.get("d", {})
        identify = {
            "rpcVersion": min(1, int(hello_data.get("rpcVersion", 1))),
            "eventSubscriptions": 0,
        }
        if hello_data.get("authentication"):
            identify["authentication"] = auth_response(
                config.get("server_password", ""),
                hello_data["authentication"],
            )
        await websocket.send(json.dumps({"op": 1, "d": identify}, separators=(",", ":")))
        identified = json.loads(await websocket.recv())
        if identified.get("op") != 2:
            await websocket.close()
            raise RuntimeError("OBS WebSocket authentication failed")
        return cls(websocket)

    async def trigger(self, key_id, modifiers):
        self.request_id += 1
        request_id = f"numpad-{self.request_id}"
        await self.websocket.send(json.dumps({
            "op": 6,
            "d": {
                "requestType": "TriggerHotkeyBySequence",
                "requestId": request_id,
                "requestData": {
                    "keyId": key_id,
                    "keyModifiers": modifiers,
                },
            },
        }, separators=(",", ":")))
        while True:
            response = json.loads(await self.websocket.recv())
            if response.get("op") != 7 or response.get("d", {}).get("requestId") != request_id:
                continue
            status = response["d"].get("requestStatus", {})
            if not status.get("result"):
                raise RuntimeError(status.get("comment", "OBS hotkey request failed"))
            return


async def run():
    device = None
    pressed = set()
    while True:
        try:
            if device is None:
                device = find_device()
                if device is None:
                    await asyncio.sleep(1)
                    continue
                print(f"Reading {DEVICE_NAME} from {device.path}", flush=True)

            obs = await ObsConnection.open()
            print("Connected to OBS WebSocket", flush=True)
            try:
                async for event in device.async_read_loop():
                    if event.type != ecodes.EV_KEY:
                        continue
                    if event.value == 1:
                        pressed.add(event.code)
                    elif event.value == 0:
                        pressed.discard(event.code)
                    else:
                        continue

                    key_id = NUMPAD_HOTKEYS.get(event.code)
                    if key_id is None or not (
                        ecodes.KEY_LEFTSHIFT in pressed
                        or ecodes.KEY_RIGHTSHIFT in pressed
                    ):
                        continue

                    await obs.trigger(key_id, {
                        "shift": True,
                        "alt": False,
                        "command": False,
                        "control": False,
                    })
                    print(f"Triggered OBS hotkey: Shift+{key_id}", flush=True)
            finally:
                await obs.websocket.close()
        except (ConnectionClosed, FileNotFoundError, OSError, RuntimeError, json.JSONDecodeError) as error:
            print(f"OBS numpad hotkeys waiting: {error}", flush=True)
            if isinstance(error, OSError):
                device = None
                pressed.clear()
            await asyncio.sleep(RETRY_SECONDS)


if __name__ == "__main__":
    asyncio.run(run())
