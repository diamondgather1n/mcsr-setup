#!/usr/bin/env bash

set -euo pipefail

interval="${JAY_LAG_INTERVAL:-0.05}"
threshold="${JAY_LAG_THRESHOLD:-0.20}"
log_dir="${JAY_LAG_LOG_DIR:-$HOME/.local/share/jay-lag-monitor}"
mkdir -p "$log_dir"
log_file="$log_dir/lag-$(date +%Y%m%d-%H%M%S).log"

latest_jay_log() {
    find "$HOME/.local/share/jay/logs/jay" -maxdepth 1 -type f -printf '%T@ %p\n' 2>/dev/null \
        | sort -nr \
        | awk 'NR == 1 { print $2 }'
}

stamp_ns() {
    date +%s%N
}

stamp_human() {
    date '+%F %T.%3N %Z'
}

write_snapshot() {
    local delay="$1" jay_log
    jay_log="$(latest_jay_log)"

    {
        printf '\n===== lag spike %s delay=%ss =====\n' "$(stamp_human)" "$delay"
        printf '\n--- top processes ---\n'
        ps -eo pid,ppid,stat,ni,pri,psr,pcpu,pmem,etime,comm,args --sort=-pcpu | head -35
        printf '\n--- suspicious waits ---\n'
        ps -eo pid,ppid,stat,wchan:28,etime,comm,args \
            | awk '/jay\.real|waywall|java|obs|pipewire|wireplumber|pw-link|kdeconnect|kded6|kactivity|Xwayland/ { print }'
        printf '\n--- recent user journal ---\n'
        journalctl --user --since '2 minutes ago' --no-pager 2>&1 | tail -120
        printf '\n--- recent kernel journal ---\n'
        journalctl -k --since '2 minutes ago' --no-pager 2>&1 | tail -120
        if [[ -n "$jay_log" ]]; then
            printf '\n--- jay log tail: %s ---\n' "$jay_log"
            tail -120 "$jay_log"
        fi
    } >>"$log_file"
}

printf 'Jay lag monitor writing to %s\n' "$log_file"
printf 'Threshold: %ss, interval: %ss\n' "$threshold" "$interval"
printf 'Leave this running while playing. Press Ctrl+C to stop.\n'

last_ns="$(stamp_ns)"
while :; do
    sleep "$interval"
    now_ns="$(stamp_ns)"
    delay="$(
        awk -v now="$now_ns" -v last="$last_ns" -v interval="$interval" \
            'BEGIN { printf "%.6f", ((now - last) / 1000000000) - interval }'
    )"
    if awk -v delay="$delay" -v threshold="$threshold" 'BEGIN { exit(delay >= threshold ? 0 : 1) }'; then
        printf '[%s] lag spike delay=%ss\n' "$(stamp_human)" "$delay" | tee -a "$log_file"
        write_snapshot "$delay"
    fi
    last_ns="$now_ns"
done
