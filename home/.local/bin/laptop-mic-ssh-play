#!/usr/bin/env bash
set -euo pipefail

sink="${CHROMEBOOK_MIC_INTERMEDIATE_SINK:-Intermediate-Chromebook-Mic}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

command -v pw-cat >/dev/null 2>&1 || {
  echo "Missing required command: pw-cat" >&2
  exit 1
}

exec pw-cat --playback --raw --target "$sink" --rate 48000 --channels 1 --format s16 -
