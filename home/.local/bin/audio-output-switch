#!/usr/bin/env bash

set -euo pipefail

readonly CARD_NAME="alsa_card.pci-0000_0d_00.6"
readonly ANALOG_PROFILE_INDEX=1
readonly EARBUDS_SINK="alsa_output.pci-0000_0d_00.6.analog-stereo"
readonly MONITOR_SINK="alsa_output.pci-0000_01_00.1.hdmi-stereo-extra2"
readonly HEADPHONES_SINK="alsa_output.usb-Logi_USB_Headset_Logi_USB_Headset-00.analog-stereo"

usage() {
    printf 'Usage: %s earbuds|monitor|headphones\n' "${0##*/}" >&2
    exit 2
}

node_id() {
    local target=$1

    wpctl status -n | awk -v target="$target" '
        !found && index($0, target) {
            for (i = 1; i <= NF; i++) {
                if ($i ~ /^[0-9]+\.$/) {
                    sub(/\.$/, "", $i)
                    print $i
                    found = 1
                    break
                }
            }
        }
    '
}

ensure_earbuds_sink() {
    local card_id

    for _ in {1..50}; do
        card_id=$(node_id "$CARD_NAME")
        [[ -n $card_id ]] && break
        sleep 0.1
    done

    if [[ -z $card_id ]]; then
        printf 'Audio card not found: %s\n' "$CARD_NAME" >&2
        exit 1
    fi

    wpctl set-profile "$card_id" "$ANALOG_PROFILE_INDEX"

    for _ in {1..30}; do
        if pactl list short sinks | grep -Fq "$EARBUDS_SINK"; then
            pactl set-sink-port "$EARBUDS_SINK" analog-output-lineout
            return
        fi
        sleep 0.1
    done

    printf 'Analog output did not appear: %s\n' "$EARBUDS_SINK" >&2
    exit 1
}

move_playing_audio() {
    local sink=$1 input_id

    while read -r input_id; do
        [[ -n $input_id ]] && pactl move-sink-input "$input_id" "$sink"
    done < <(
        pactl list sink-inputs | awk '
            /^Sink Input #[0-9]+/ {
                if (id && !protected) print id
                id = $3
                sub(/^#/, "", id)
                protected = 0
                next
            }
            /target\.object = "(Intermediate-Chromebook-Mic|Laptop-Speaker)"/ {
                protected = 1
            }
            END {
                if (id && !protected) print id
            }
        '
    )
}

disable_stream_target_restore() {
    wpctl settings node.stream.restore-target false -s >/dev/null
}

case ${1:-} in
    earbuds)
        ensure_earbuds_sink
        sink=$EARBUDS_SINK
        label="Earbuds"
        mic_mode=earbuds
        ;;
    monitor)
        sink=$MONITOR_SINK
        label="Monitor speakers"
        ;;
    headphones)
        sink=$HEADPHONES_SINK
        label="Headphones"
        mic_mode=headphones
        ;;
    *) usage ;;
esac

disable_stream_target_restore

sink_id=$(node_id "$sink")
if [[ -z $sink_id ]]; then
    printf 'Audio output not found: %s\n' "$sink" >&2
    exit 1
fi

wpctl set-default "$sink_id"
move_playing_audio "$sink"
if [[ -n ${mic_mode:-} ]]; then
    "$HOME/.local/bin/obs-mic-switch" "$mic_mode"
fi
printf 'Audio output: %s\n' "$label"
