#!/usr/bin/env bash
set -euo pipefail

mode="${1:---prompt}"
repo="MCSRLauncher/Launcher"
base="/home/nathan/MCSR/CrossDisplayManager"
state_dir="$HOME/.local/share/mcsrlauncher"
state_file="$state_dir/latest-tag"

mkdir -p "$state_dir"

jar="$(
  find "$base" -type f -iname '*mcsr*launcher*.jar' 2>/dev/null \
  | grep -vi 'updater' \
  | sort -V \
  | tail -n 1
)"

if [ -z "${jar:-}" ]; then
  echo "Could not find MCSRLauncher jar under: $base"
  exit 1
fi

info="$(
python - "$repo" <<'PY'
import json
import sys
import urllib.request

repo = sys.argv[1]
api = f"https://api.github.com/repos/{repo}/releases/latest"

try:
    req = urllib.request.Request(api, headers={"User-Agent": "mcsr-auto-updater"})
    with urllib.request.urlopen(req, timeout=5) as r:
        release = json.load(r)
except Exception as e:
    print("ERROR|" + str(e))
    sys.exit(0)

tag = release.get("tag_name") or release.get("name") or "unknown"
assets = release.get("assets", [])

for a in assets:
    name = a.get("name", "")
    url = a.get("browser_download_url", "")
    low = name.lower()
    if low.endswith(".jar") and "mcsrlauncher" in low and "updater" not in low:
        print(f"OK|{tag}|{name}|{url}")
        sys.exit(0)

print("NOASSET|" + tag)
PY
)"

case "$info" in
  ERROR\|*)
    echo "Update check failed, launching anyway: ${info#ERROR|}" >&2
    exit 0
    ;;
  NOASSET\|*)
    echo "No launcher jar asset found in latest release, launching anyway." >&2
    exit 0
    ;;
esac

IFS='|' read -r status latest_tag asset_name asset_url <<< "$info"

current_tag=""
[ -f "$state_file" ] && current_tag="$(cat "$state_file" 2>/dev/null || true)"

if [ "$current_tag" = "$latest_tag" ]; then
  exit 0
fi

answer=""

if [ "$mode" = "--force" ]; then
  answer="yes"
elif [ "$mode" = "--check" ]; then
  echo "Latest available: $latest_tag"
  echo "Asset: $asset_name"
  echo "Current recorded: ${current_tag:-unknown}"
  exit 0
else
  if [ -t 0 ]; then
    printf "Update MCSR Launcher to %s? [y/N] " "$latest_tag"
    read -r answer
  elif command -v bemenu >/dev/null 2>&1; then
    answer="$(printf "No\nYes\n" | bemenu -p "Update MCSR Launcher to $latest_tag?")"
  else
    echo "Update available: $latest_tag, but no terminal/bemenu prompt available. Launching anyway." >&2
    exit 0
  fi
fi

case "$answer" in
  y|Y|yes|Yes|YES)
    ;;
  *)
    echo "$latest_tag" > "$state_file"
    exit 0
    ;;
esac

tmp="$(mktemp --suffix=.jar)"
trap 'rm -f "$tmp"' EXIT

echo "Downloading $asset_name..."
python - "$asset_url" "$tmp" <<'PY'
import sys
import urllib.request

url = sys.argv[1]
out = sys.argv[2]

req = urllib.request.Request(url, headers={"User-Agent": "mcsr-auto-updater"})
with urllib.request.urlopen(req, timeout=60) as r, open(out, "wb") as f:
    f.write(r.read())
PY

if ! jar tf "$tmp" >/dev/null 2>&1; then
  echo "Downloaded file is not a valid jar. Not replacing anything." >&2
  exit 1
fi

rm -f "$jar"
install -m 0644 "$tmp" "$jar"
echo "$latest_tag" > "$state_file"

echo "Updated MCSR Launcher to $latest_tag"
