#!/usr/bin/env bash
set -euo pipefail

source_name="alsa_input.pci-0000_0d_00.6.analog-stereo"
choice="${1:-linein}"
volume="${2:-70%}"

case "$choice" in
  linein|line-in)
    port="analog-input-linein"
    ;;
  rear|rear-mic)
    port="analog-input-rear-mic"
    ;;
  front|front-mic)
    port="analog-input-front-mic"
    ;;
  *)
    echo "Usage: laptop-mic-pc-use-analog [linein|rear-mic|front-mic] [volume]" >&2
    exit 2
    ;;
esac

pactl set-source-port "$source_name" "$port" >/dev/null 2>&1 || true
pactl set-default-source "$source_name"
pactl set-source-volume "$source_name" "$volume"
pactl set-source-mute "$source_name" 0

echo "Default PC mic set to $source_name on $port at $volume"
