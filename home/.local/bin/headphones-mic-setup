#!/usr/bin/env bash

set -euo pipefail

readonly HEADPHONES_SOURCE="alsa_input.usb-Logi_USB_Headset_Logi_USB_Headset-00.mono-fallback"
readonly REMAPPED_SOURCE="HeadPhones-Mic"
readonly PW_LINK_TIMEOUT="2s"

source_exists() {
    pactl list short sources | awk -v name="$1" '$2 == name { found=1 } END { exit(found ? 0 : 1) }'
}

port_id() {
    local direction="$1" name="$2"
    pw-link -I "$direction" | awk -v name="$name" '$2 == name { print $1; exit }'
}

chromebook_obs_target() {
    local source="$1"
    pw-link -I -l | awk -v source="$source" '
        $2 == source { seeking=1; next }
        seeking && $2 == "|->" && $3 ~ /^[0-9]+$/ { print $3; exit }
        seeking && NF && $2 != "|->" { seeking=0 }
    '
}

obs2_targets() {
    pw-dump -N | python3 -c '
import json
import sys

objects = json.load(sys.stdin)
node_ids = {
    str(item["id"])
    for item in objects
    if item.get("type", "").endswith(":Node")
    and item.get("info", {}).get("props", {}).get("media.name") == "Mic/Aux 2"
}
ports = {}
for item in objects:
    if not item.get("type", "").endswith(":Port"):
        continue
    info = item.get("info", {})
    props = info.get("props", {})
    if info.get("direction") != "input" or str(props.get("node.id")) not in node_ids:
        continue
    channel = props.get("audio.channel")
    if channel in ("FL", "FR"):
        ports[channel] = str(item["id"])
print(ports.get("FL", ""), ports.get("FR", ""))
'
}

link_exists() {
    local source_id="$1" target_id="$2"
    pw-link -I -l | awk -v source="$source_id" -v target="$target_id" '
        $1 == source { seeking=1; next }
        seeking && $2 == "|->" && $3 == target { found=1; exit }
        seeking && NF && $2 != "|->" { seeking=0 }
        END { exit(found ? 0 : 1) }
    '
}

ensure_obs_mic_links() {
    local chromebook_target_fl chromebook_target_fr target_fl target_fr headphones_fl headphones_fr raw_source

    chromebook_target_fl=$(chromebook_obs_target "Chromebook-Mic:capture_FL")
    chromebook_target_fr=$(chromebook_obs_target "Chromebook-Mic:capture_FR")
    read -r target_fl target_fr < <(obs2_targets)
    headphones_fl=$(port_id -o "HeadPhones-Mic:capture_FL")
    headphones_fr=$(port_id -o "HeadPhones-Mic:capture_FR")
    raw_source="alsa_input.usb-Logi_USB_Headset_Logi_USB_Headset-00.mono-fallback:capture_MONO"

    if [[ -n "$target_fl" && -n "$headphones_fl" ]] && ! link_exists "$headphones_fl" "$target_fl"; then
        timeout "$PW_LINK_TIMEOUT" pw-link -w "$headphones_fl" "$target_fl" >/dev/null 2>&1 || true
    fi
    if [[ -n "$target_fr" && -n "$headphones_fr" ]] && ! link_exists "$headphones_fr" "$target_fr"; then
        timeout "$PW_LINK_TIMEOUT" pw-link -w "$headphones_fr" "$target_fr" >/dev/null 2>&1 || true
    fi

    while read -r link_id; do
        [[ -n "$link_id" ]] && timeout "$PW_LINK_TIMEOUT" pw-link -d "$link_id" >/dev/null 2>&1 || true
    done < <(
        pw-link -I -l | awk -v source="$raw_source" -v target_fl="$chromebook_target_fl" -v target_fr="$chromebook_target_fr" '
            $2 == source { seeking=1; next }
            seeking && $2 == "|->" && ($3 == target_fl || $3 == target_fr) { print $1; next }
            seeking && NF && $2 != "|->" { seeking=0 }
        '
    )

    while read -r link_id; do
        [[ -n "$link_id" ]] && timeout "$PW_LINK_TIMEOUT" pw-link -d "$link_id" >/dev/null 2>&1 || true
    done < <(
        pw-link -I -l | awk -v source_fl="$headphones_fl" -v source_fr="$headphones_fr" -v target_fl="$chromebook_target_fl" -v target_fr="$chromebook_target_fr" '
            ($1 == source_fl || $1 == source_fr) { seeking=1; next }
            seeking && $2 == "|->" && ($3 == target_fl || $3 == target_fr) { print $1; next }
            seeking && NF && $2 != "|->" { seeking=0 }
        '
    )
}

while :; do
    if source_exists "$HEADPHONES_SOURCE"; then
        if ! source_exists "$REMAPPED_SOURCE"; then
            pactl load-module module-remap-source \
                "source_name=${REMAPPED_SOURCE}" \
                "master=${HEADPHONES_SOURCE}" \
                "source_properties=device.description=${REMAPPED_SOURCE}" \
                >/dev/null
        fi
        "$HOME/.local/bin/obs-mic-switch" ensure || true
    fi
    sleep 3
done
