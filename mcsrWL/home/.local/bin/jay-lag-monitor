#!/usr/bin/env python3

import os
import subprocess
import time
from datetime import datetime
from pathlib import Path


INTERVAL = float(os.environ.get("JAY_LAG_INTERVAL", "0.05"))
THRESHOLD = float(os.environ.get("JAY_LAG_THRESHOLD", "0.10"))
LOG_DIR = Path(
    os.environ.get(
        "JAY_LAG_LOG_DIR",
        str(Path.home() / ".local/share/jay-lag-monitor"),
    )
).expanduser()

if INTERVAL <= 0 or THRESHOLD <= 0:
    raise SystemExit("JAY_LAG_INTERVAL and JAY_LAG_THRESHOLD must be positive")

LOG_DIR.mkdir(parents=True, exist_ok=True)
LOG_FILE = LOG_DIR / f"lag-{datetime.now():%Y%m%d-%H%M%S}.log"
LOG_FILE.touch(mode=0o600)


def timestamp() -> str:
    return datetime.now().astimezone().strftime("%F %T.%f")[:-3] + " %Z"


def command_output(command: list[str]) -> list[str]:
    try:
        result = subprocess.run(
            command,
            check=False,
            capture_output=True,
            text=True,
            timeout=5,
        )
    except (OSError, subprocess.SubprocessError) as error:
        return [f"Could not run {command[0]}: {error}"]
    return (result.stdout + result.stderr).splitlines()


def latest_jay_log() -> Path | None:
    directory = Path.home() / ".local/share/jay/logs/jay"
    try:
        return max(
            (path for path in directory.iterdir() if path.is_file()),
            key=lambda path: path.stat().st_mtime_ns,
        )
    except (OSError, ValueError):
        return None


def recent_lines(path: Path, count: int) -> list[str]:
    try:
        with path.open("r", errors="replace") as stream:
            return stream.read().splitlines()[-count:]
    except OSError as error:
        return [f"Could not read {path}: {error}"]


def write_section(stream, title: str, lines: list[str]) -> None:
    stream.write(f"\n--- {title} ---\n")
    for line in lines:
        stream.write(f"{line}\n")


def write_snapshot(delay: float) -> None:
    process_lines = command_output(
        [
            "ps",
            "-eo",
            "pid,ppid,stat,ni,pri,psr,pcpu,pmem,etime,comm",
            "--sort=-pcpu",
        ]
    )
    wait_lines = command_output(
        ["ps", "-eo", "pid,ppid,stat,wchan:28,etime,comm"]
    )
    suspicious = (
        "jay.real",
        "waywall",
        "java",
        "obs",
        "pipewire",
        "wireplumber",
        "pw-link",
        "xwayland",
    )
    wait_lines = [
        line for line in wait_lines if any(name in line.lower() for name in suspicious)
    ]

    with LOG_FILE.open("a") as stream:
        stream.write(f"\n===== lag spike {timestamp()} delay={delay:.6f}s =====\n")
        write_section(stream, "top processes", process_lines[:36])
        write_section(stream, "suspicious waits", wait_lines)
        write_section(
            stream,
            "recent user journal",
            command_output(
                [
                    "journalctl",
                    "--user",
                    "--since",
                    "2 minutes ago",
                    "--no-pager",
                ]
            )[-120:],
        )
        write_section(
            stream,
            "recent kernel journal",
            command_output(
                [
                    "journalctl",
                    "-k",
                    "--since",
                    "2 minutes ago",
                    "--no-pager",
                ]
            )[-120:],
        )
        jay_log = latest_jay_log()
        if jay_log is not None:
            write_section(stream, f"jay log tail: {jay_log}", recent_lines(jay_log, 120))


try:
    os.nice(10)
except OSError:
    pass

print(f"Jay lag monitor writing to {LOG_FILE}")
print(f"Threshold: {THRESHOLD:.3f}s, interval: {INTERVAL:.3f}s")
print("Leave this running while playing. Press Ctrl+C to stop.")

try:
    expected = time.monotonic() + INTERVAL
    while True:
        time.sleep(max(0.0, expected - time.monotonic()))
        now = time.monotonic()
        delay = now - expected
        if delay >= THRESHOLD:
            message = f"[{timestamp()}] lag spike delay={delay:.6f}s"
            print(message, flush=True)
            with LOG_FILE.open("a") as stream:
                stream.write(message + "\n")
            write_snapshot(delay)
            now = time.monotonic()
        expected = now + INTERVAL
except KeyboardInterrupt:
    print("\nStopped.")
