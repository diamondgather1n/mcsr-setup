#!/usr/bin/env python3
"""Explicit input recorder and replayer for the keyd -> Jay input path."""

import argparse
import collections
import datetime as datetime_module
import fcntl
import json
import math
import os
import re
import selectors
import select
import signal
import struct
import subprocess
import sys
import threading
import time
from contextlib import contextmanager
from pathlib import Path


APP_NAME = "Input Recorder"
STATE_DIR = Path.home() / ".local/state/input-recorder"
DATA_DIR = Path.home() / ".local/share/input-recorder"
RECORDINGS_DIR = DATA_DIR / "recordings"
ACTIVE_FILE = STATE_DIR / "active.json"
PLAYBACK_FILE = STATE_DIR / "playback.json"
WORKER_LOG = STATE_DIR / "worker.log"
RECORD_LOCK = STATE_DIR / "record.lock"

MAGIC = b"IREC1\0"
HEADER_LENGTH = struct.Struct("<I")
INPUT_EVENT = struct.Struct("llHHi")
STORED_EVENT = struct.Struct("<QBHHi")

EV_SYN = 0
EV_KEY = 1
EV_REL = 2
SYN_REPORT = 0

REL_X = 0
REL_Y = 1
REL_HWHEEL = 6
REL_WHEEL = 8
REL_WHEEL_HI_RES = 11
REL_HWHEEL_HI_RES = 12

KEY_LEFTSHIFT = 42
KEY_RIGHTSHIFT = 54
KEY_F9 = 67
KEY_F12 = 88
KEY_LEFTMETA = 125
KEY_RIGHTMETA = 126

BTN_LEFT = 272
BTN_RIGHT = 273
BTN_MIDDLE = 274
BTN_SIDE = 275
BTN_EXTRA = 276

TOGGLE_FILTER_CODES = {KEY_F9, KEY_LEFTMETA, KEY_RIGHTMETA}
SHIFT_CODES = {KEY_LEFTSHIFT, KEY_RIGHTSHIFT}
BUTTON_COMMANDS = {
    BTN_LEFT: "left",
    BTN_RIGHT: "right",
    BTN_MIDDLE: "middle",
}
BUTTON_NAMES = {
    BTN_LEFT: "mouse-left",
    BTN_RIGHT: "mouse-right",
    BTN_MIDDLE: "mouse-middle",
    BTN_SIDE: "mouse-side",
    BTN_EXTRA: "mouse-extra",
}


def ensure_directories():
    for directory in (STATE_DIR, DATA_DIR, RECORDINGS_DIR):
        directory.mkdir(parents=True, exist_ok=True, mode=0o700)
        directory.chmod(0o700)


def atomic_json(path, payload):
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    with temporary.open("w", encoding="utf-8") as handle:
        json.dump(payload, handle, indent=2, sort_keys=True)
        handle.write("\n")
    temporary.chmod(0o600)
    os.replace(temporary, path)


def read_json(path):
    try:
        with path.open("r", encoding="utf-8") as handle:
            return json.load(handle)
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return None


def process_is_ours(pid):
    try:
        command = Path(f"/proc/{pid}/cmdline").read_bytes()
    except (FileNotFoundError, PermissionError, ProcessLookupError, ValueError):
        return False
    return b"input-recorder" in command


def active_state(path):
    state = read_json(path)
    if not state:
        return None
    try:
        pid = int(state["pid"])
    except (KeyError, TypeError, ValueError):
        return None
    return state if process_is_ours(pid) else None


def notify(summary, body="", urgency="normal"):
    command = ["notify-send", "--app-name", APP_NAME, "--urgency", urgency, summary]
    if body:
        command.append(body)
    try:
        subprocess.run(
            command,
            check=False,
            timeout=2,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except (FileNotFoundError, subprocess.SubprocessError):
        pass


def event_device_names():
    devices = {}
    for path in sorted(Path("/dev/input").glob("event*")):
        name_path = Path("/sys/class/input") / path.name / "device/name"
        try:
            devices[name_path.read_text(encoding="utf-8").strip()] = path
        except (FileNotFoundError, PermissionError, OSError):
            continue
    return devices


def required_devices():
    devices = event_device_names()
    missing = [
        name
        for name in ("keyd virtual keyboard", "keyd virtual pointer")
        if name not in devices
    ]
    if missing:
        raise RuntimeError(
            "Missing input device(s): "
            + ", ".join(missing)
            + ". Check that keyd is running."
        )
    return [
        ("keyboard", "keyd virtual keyboard", devices["keyd virtual keyboard"]),
        ("pointer", "keyd virtual pointer", devices["keyd virtual pointer"]),
    ]


def set_monotonic_clock(fd):
    # EVIOCSCLOCKID with CLOCK_MONOTONIC. Older kernels may reject it.
    try:
        fcntl.ioctl(fd, 0x400445A0, struct.pack("i", time.CLOCK_MONOTONIC))
    except OSError:
        pass


def safe_slug(value):
    value = re.sub(r"[^A-Za-z0-9._-]+", "-", value.strip()).strip("-._")
    return value[:60] or "recording"


def next_recording_path(name):
    stamp = datetime_module.datetime.now().astimezone().strftime("%Y-%m-%d_%H-%M-%S")
    base = RECORDINGS_DIR / f"{stamp}-{safe_slug(name)}.irec"
    if not base.exists():
        return base
    for index in range(2, 1000):
        candidate = base.with_name(f"{base.stem}-{index}.irec")
        if not candidate.exists():
            return candidate
    raise RuntimeError("Could not choose a unique recording filename")


def write_recording_header(handle, header):
    encoded = json.dumps(header, separators=(",", ":"), sort_keys=True).encode("utf-8")
    handle.write(MAGIC)
    handle.write(HEADER_LENGTH.pack(len(encoded)))
    handle.write(encoded)


@contextmanager
def open_recording(path):
    handle = path.open("rb")
    try:
        if handle.read(len(MAGIC)) != MAGIC:
            raise ValueError(f"{path} is not an input-recorder file")
        raw_length = handle.read(HEADER_LENGTH.size)
        if len(raw_length) != HEADER_LENGTH.size:
            raise ValueError(f"{path} has a truncated header")
        header_length = HEADER_LENGTH.unpack(raw_length)[0]
        header_data = handle.read(header_length)
        if len(header_data) != header_length:
            raise ValueError(f"{path} has a truncated header")
        header = json.loads(header_data.decode("utf-8"))
        yield header, handle
    finally:
        handle.close()


def stored_events(handle):
    while True:
        data = handle.read(STORED_EVENT.size)
        if not data:
            return
        if len(data) != STORED_EVENT.size:
            raise ValueError("Recording ends with a partial event")
        yield STORED_EVENT.unpack(data)


def recording_worker(path):
    ensure_directories()
    lock_handle = RECORD_LOCK.open("a+")
    try:
        fcntl.flock(lock_handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print("Another recording worker is already running", file=sys.stderr)
        return 1

    devices = required_devices()
    stop_requested = threading.Event()

    def request_stop(_signum, _frame):
        stop_requested.set()

    signal.signal(signal.SIGTERM, request_stop)
    signal.signal(signal.SIGINT, request_stop)

    selector = selectors.DefaultSelector()
    buffers = {}
    descriptors = []
    for device_id, (kind, name, device_path) in enumerate(devices):
        fd = os.open(device_path, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
        set_monotonic_clock(fd)
        selector.register(fd, selectors.EVENT_READ, device_id)
        buffers[fd] = bytearray()
        descriptors.append(fd)

    started_wall = time.time()
    started_monotonic_ns = time.monotonic_ns()
    header = {
        "format": 1,
        "started_at": datetime_module.datetime.now().astimezone().isoformat(),
        "devices": [
            {"id": index, "kind": kind, "name": name, "path": str(device_path)}
            for index, (kind, name, device_path) in enumerate(devices)
        ],
        "capture_point": "keyd virtual devices before Jay and Waywall",
    }
    state = {
        "pid": os.getpid(),
        "path": str(path),
        "started_wall": started_wall,
        "started_at": header["started_at"],
    }

    event_count = 0
    last_time_ns = 0
    last_flush = time.monotonic()
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    try:
        with path.open("xb") as output:
            path.chmod(0o600)
            write_recording_header(output, header)
            output.flush()
            atomic_json(ACTIVE_FILE, state)

            while not stop_requested.is_set():
                for selected, _mask in selector.select(timeout=0.1):
                    fd = selected.fd
                    device_id = selected.data
                    try:
                        chunk = os.read(fd, INPUT_EVENT.size * 256)
                    except BlockingIOError:
                        continue
                    if not chunk:
                        continue
                    buffers[fd].extend(chunk)
                    buffer = buffers[fd]
                    offset = 0
                    while len(buffer) - offset >= INPUT_EVENT.size:
                        seconds, micros, event_type, code, value = INPUT_EVENT.unpack_from(
                            buffer, offset
                        )
                        offset += INPUT_EVENT.size

                        if event_type not in (EV_SYN, EV_KEY, EV_REL):
                            continue
                        if event_type == EV_KEY and code in TOGGLE_FILTER_CODES:
                            continue

                        kernel_ns = seconds * 1_000_000_000 + micros * 1_000
                        if abs(kernel_ns - time.monotonic_ns()) > 10_000_000_000:
                            kernel_ns = time.monotonic_ns()
                        relative_ns = max(0, kernel_ns - started_monotonic_ns)
                        output.write(
                            STORED_EVENT.pack(
                                relative_ns, device_id, event_type, code, value
                            )
                        )
                        event_count += 1
                        last_time_ns = max(last_time_ns, relative_ns)
                    if offset:
                        del buffer[:offset]

                if time.monotonic() - last_flush >= 1:
                    output.flush()
                    last_flush = time.monotonic()

            output.flush()
            os.fsync(output.fileno())
    finally:
        try:
            ACTIVE_FILE.unlink()
        except FileNotFoundError:
            pass
        for fd in descriptors:
            try:
                selector.unregister(fd)
            except (KeyError, ValueError):
                pass
            os.close(fd)
        selector.close()
        lock_handle.close()

    metadata = {
        "events": event_count,
        "duration_ns": last_time_ns,
        "stopped_at": datetime_module.datetime.now().astimezone().isoformat(),
    }
    atomic_json(path.with_suffix(".meta.json"), metadata)
    report = build_shift_report(path)
    report_path = path.with_suffix(".shift.txt")
    report_path.write_text(report, encoding="utf-8")
    report_path.chmod(0o600)
    return 0


def start_recording(name):
    ensure_directories()
    current = active_state(ACTIVE_FILE)
    if current:
        raise RuntimeError(f"Already recording: {current['path']}")
    if active_state(PLAYBACK_FILE):
        raise RuntimeError("Cannot record while playback is active")

    required_devices()
    path = next_recording_path(name)
    log_handle = WORKER_LOG.open("ab")
    process = subprocess.Popen(
        [sys.executable, str(Path(__file__).resolve()), "_record", str(path)],
        stdin=subprocess.DEVNULL,
        stdout=log_handle,
        stderr=subprocess.STDOUT,
        start_new_session=True,
        close_fds=True,
    )
    log_handle.close()

    deadline = time.monotonic() + 3
    while time.monotonic() < deadline:
        state = active_state(ACTIVE_FILE)
        if state and int(state["pid"]) == process.pid:
            print(f"Recording: {path}")
            notify("Recording started", path.name, "critical")
            return 0
        if process.poll() is not None:
            break
        time.sleep(0.05)

    details = ""
    try:
        details = WORKER_LOG.read_text(encoding="utf-8", errors="replace")[-1000:]
    except OSError:
        pass
    raise RuntimeError("Recorder did not start" + (f": {details.strip()}" if details else ""))


def stop_recording():
    state = active_state(ACTIVE_FILE)
    if not state:
        print("Recorder is not running")
        return 1
    pid = int(state["pid"])
    path = Path(state["path"])
    os.kill(pid, signal.SIGTERM)
    deadline = time.monotonic() + 8
    while time.monotonic() < deadline and process_is_ours(pid):
        time.sleep(0.05)
    if process_is_ours(pid):
        raise RuntimeError(f"Recorder process {pid} did not stop")
    print(f"Saved: {path}")
    print(f"Shift report: {path.with_suffix('.shift.txt')}")
    notify("Recording saved", path.name)
    return 0


def toggle_recording(name):
    if active_state(ACTIVE_FILE):
        return stop_recording()
    return start_recording(name)


def key_names():
    names = {}
    try:
        output = subprocess.check_output(
            ["dotool", "--list-keys"], text=True, stderr=subprocess.DEVNULL
        )
        for line in output.splitlines():
            match = re.fullmatch(r"(\S+)\s+k:(\d+)", line.strip())
            if match:
                names[int(match.group(2))] = match.group(1)
    except (FileNotFoundError, subprocess.SubprocessError):
        pass
    names.update(BUTTON_NAMES)
    return names


def format_offset(nanoseconds):
    milliseconds = max(0, nanoseconds) // 1_000_000
    minutes, milliseconds = divmod(milliseconds, 60_000)
    seconds, milliseconds = divmod(milliseconds, 1_000)
    return f"{minutes}:{seconds:02d}.{milliseconds:03d}"


def build_shift_report(path):
    names = key_names()
    holds = []
    shift_down = set()
    current = None
    duration_ns = 0

    with open_recording(path) as (header, handle):
        for timestamp_ns, _device, event_type, code, value in stored_events(handle):
            duration_ns = max(duration_ns, timestamp_ns)
            if event_type == EV_KEY and code in SHIFT_CODES:
                if value == 1:
                    if not shift_down:
                        current = {
                            "start": timestamp_ns,
                            "end": timestamp_ns,
                            "keys": collections.Counter(),
                            "timeline": [],
                            "mouse_counts": 0,
                            "wheel": 0,
                            "hwheel": 0,
                        }
                    shift_down.add(code)
                elif value == 0:
                    shift_down.discard(code)
                    if not shift_down and current is not None:
                        current["end"] = timestamp_ns
                        holds.append(current)
                        current = None
                continue

            if current is None:
                continue
            current["end"] = timestamp_ns
            if event_type == EV_KEY and value == 1:
                name = names.get(code, f"key-{code}")
                current["keys"][name] += 1
                current["timeline"].append((timestamp_ns, name))
            elif event_type == EV_REL:
                if code in (REL_X, REL_Y):
                    current["mouse_counts"] += abs(value)
                elif code in (REL_WHEEL, REL_WHEEL_HI_RES):
                    current["wheel"] += value
                elif code in (REL_HWHEEL, REL_HWHEEL_HI_RES):
                    current["hwheel"] += value

    if current is not None:
        current["end"] = duration_ns
        holds.append(current)

    total_shift_ns = sum(max(0, hold["end"] - hold["start"]) for hold in holds)
    overall = collections.Counter()
    for hold in holds:
        overall.update(hold["keys"])

    lines = [
        f"Recording: {path.name}",
        f"Started: {header.get('started_at', 'unknown')}",
        f"Duration: {format_offset(duration_ns)}",
        f"Shift holds: {len(holds)}",
        f"Total Shift time: {format_offset(total_shift_ns)}",
        "",
    ]
    if overall:
        lines.append("Keys/clicks pressed while Shift was held:")
        lines.append(", ".join(f"{name} x{count}" for name, count in overall.most_common()))
        lines.append("")

    if not holds:
        lines.append("No Shift holds were recorded.")
    for index, hold in enumerate(holds, 1):
        length = hold["end"] - hold["start"]
        lines.append(
            f"{index}. {format_offset(hold['start'])} - "
            f"{format_offset(hold['end'])} ({length / 1_000_000:.0f} ms)"
        )
        details = []
        if hold["keys"]:
            details.append(
                "pressed: "
                + ", ".join(
                    f"{name} x{count}" for name, count in hold["keys"].most_common()
                )
            )
        if hold["mouse_counts"]:
            details.append(f"mouse movement: {hold['mouse_counts']} raw counts")
        if hold["wheel"]:
            details.append(f"wheel: {hold['wheel']}")
        if hold["hwheel"]:
            details.append(f"horizontal wheel: {hold['hwheel']}")
        if not details:
            details.append("no other input")
        lines.append("   " + "; ".join(details))
        if hold["timeline"]:
            timeline = ", ".join(
                f"+{(timestamp - hold['start']) / 1_000_000:.0f}ms {name}"
                for timestamp, name in hold["timeline"]
            )
            lines.append("   timeline: " + timeline)
    lines.append("")
    return "\n".join(lines)


def resolve_recording(value):
    ensure_directories()
    if not value or value == "latest":
        matches = list(RECORDINGS_DIR.glob("*.irec"))
        if not matches:
            raise RuntimeError("No recordings exist yet")
        return max(matches, key=lambda item: item.stat().st_mtime_ns)

    candidate = Path(value).expanduser()
    if candidate.exists():
        return candidate.resolve()
    if not candidate.suffix:
        candidate = RECORDINGS_DIR / f"{value}.irec"
    elif not candidate.is_absolute():
        candidate = RECORDINGS_DIR / candidate
    if candidate.exists():
        return candidate.resolve()

    matches = list(RECORDINGS_DIR.glob(f"*{value}*.irec"))
    if len(matches) == 1:
        return matches[0]
    if len(matches) > 1:
        raise RuntimeError(f"Recording name is ambiguous: {value}")
    raise RuntimeError(f"Recording not found: {value}")


def parse_offset(value):
    parts = value.strip().split(":")
    if not 1 <= len(parts) <= 3:
        raise ValueError(f"Invalid timestamp: {value}")
    try:
        seconds = float(parts[-1])
        minutes = int(parts[-2]) if len(parts) >= 2 else 0
        hours = int(parts[-3]) if len(parts) == 3 else 0
    except ValueError as error:
        raise ValueError(f"Invalid timestamp: {value}") from error
    if seconds < 0 or seconds >= 60 and len(parts) >= 2 or minutes < 0 or minutes >= 60 and len(parts) == 3 or hours < 0:
        raise ValueError(f"Invalid timestamp: {value}")
    return round((hours * 3600 + minutes * 60 + seconds) * 1_000_000_000)


def crop_recording(recording, start_value, end_value, name):
    source_path = resolve_recording(recording)
    start_ns = parse_offset(start_value)
    end_ns = parse_offset(end_value)
    if end_ns <= start_ns:
        raise ValueError("Crop end must be after crop start")

    _source_events, source_duration_ns = validate_recording(source_path)
    if start_ns >= source_duration_ns:
        raise ValueError(
            f"Crop starts after the recording ends at {format_offset(source_duration_ns)}"
        )
    if end_ns > source_duration_ns:
        raise ValueError(
            f"Crop ends after the recording ends at {format_offset(source_duration_ns)}"
        )

    output_path = next_recording_path(name)
    crop_duration_ns = end_ns - start_ns
    held = {}
    event_count = 0
    meaningful_events = 0

    try:
        with open_recording(source_path) as (source_header, source_handle):
            header = {
                "format": 1,
                "started_at": datetime_module.datetime.now().astimezone().isoformat(),
                "devices": source_header.get("devices", []),
                "capture_point": source_header.get("capture_point", "unknown"),
                "cropped_from": str(source_path),
                "source_started_at": source_header.get("started_at", "unknown"),
                "crop_start_ns": start_ns,
                "crop_end_ns": end_ns,
            }
            with output_path.open("xb") as output:
                output_path.chmod(0o600)
                write_recording_header(output, header)

                source_iterator = stored_events(source_handle)
                first_included = None
                for event in source_iterator:
                    timestamp_ns, device, event_type, code, value = event
                    if timestamp_ns >= start_ns:
                        first_included = event
                        break
                    if event_type == EV_KEY:
                        key = (device, code)
                        if value == 1:
                            held[key] = True
                        elif value == 0:
                            held.pop(key, None)

                if held:
                    sync_devices = set()
                    for device, code in sorted(held):
                        output.write(STORED_EVENT.pack(0, device, EV_KEY, code, 1))
                        event_count += 1
                        meaningful_events += 1
                        sync_devices.add(device)
                    for device in sorted(sync_devices):
                        output.write(STORED_EVENT.pack(0, device, EV_SYN, SYN_REPORT, 0))
                        event_count += 1

                def include_event(event):
                    nonlocal event_count, meaningful_events
                    timestamp_ns, device, event_type, code, value = event
                    if timestamp_ns >= end_ns:
                        return False
                    if event_type == EV_KEY:
                        key = (device, code)
                        if value == 1:
                            held[key] = True
                        elif value == 0:
                            held.pop(key, None)
                    output.write(
                        STORED_EVENT.pack(
                            timestamp_ns - start_ns, device, event_type, code, value
                        )
                    )
                    event_count += 1
                    if event_type in (EV_KEY, EV_REL):
                        meaningful_events += 1
                    return True

                if first_included is not None and include_event(first_included):
                    for event in source_iterator:
                        if not include_event(event):
                            break

                sync_devices = set()
                for device, code in sorted(held):
                    output.write(
                        STORED_EVENT.pack(
                            crop_duration_ns, device, EV_KEY, code, 0
                        )
                    )
                    event_count += 1
                    meaningful_events += 1
                    sync_devices.add(device)
                if not sync_devices:
                    sync_devices.add(0)
                for device in sorted(sync_devices):
                    output.write(
                        STORED_EVENT.pack(
                            crop_duration_ns, device, EV_SYN, SYN_REPORT, 0
                        )
                    )
                    event_count += 1
                output.flush()
                os.fsync(output.fileno())

        if not meaningful_events:
            raise ValueError("The selected crop contains no keyboard or mouse input")

        metadata = {
            "events": event_count,
            "duration_ns": crop_duration_ns,
            "stopped_at": datetime_module.datetime.now().astimezone().isoformat(),
            "cropped_from": str(source_path),
        }
        atomic_json(output_path.with_suffix(".meta.json"), metadata)
        report = build_shift_report(output_path)
        report_path = output_path.with_suffix(".shift.txt")
        report_path.write_text(report, encoding="utf-8")
        report_path.chmod(0o600)
    except Exception:
        for path in (
            output_path,
            output_path.with_suffix(".meta.json"),
            output_path.with_suffix(".shift.txt"),
        ):
            try:
                path.unlink()
            except FileNotFoundError:
                pass
        raise

    print(f"Created: {output_path}")
    print(
        f"Range: {format_offset(start_ns)} - {format_offset(end_ns)} "
        f"({format_offset(crop_duration_ns)})"
    )
    print(f"Shift report: {output_path.with_suffix('.shift.txt')}")
    return 0


def write_shift_report(value):
    path = resolve_recording(value)
    report = build_shift_report(path)
    report_path = path.with_suffix(".shift.txt")
    report_path.write_text(report, encoding="utf-8")
    report_path.chmod(0o600)
    print(report, end="")
    print(f"Saved report: {report_path}")
    return 0


def input_frames(handle):
    frame = []
    for event in stored_events(handle):
        frame.append(event)
        _timestamp, _device, event_type, code, _value = event
        if event_type == EV_SYN and code == SYN_REPORT:
            yield frame
            frame = []
    if frame:
        yield frame


def input_actions(frame, names, include_movement):
    actions = []
    relative_x = 0
    relative_y = 0
    wheel = 0
    horizontal_wheel = 0
    wheel_hi_res = 0
    horizontal_hi_res = 0

    for _timestamp, _device, event_type, code, value in frame:
        if event_type == EV_KEY:
            if value == 2:
                continue
            name = names.get(code, f"key-{code}")
            state = "down" if value == 1 else "up"
            actions.append(f"{name} {state}")
        elif event_type == EV_REL:
            if code == REL_X:
                relative_x += value
            elif code == REL_Y:
                relative_y += value
            elif code == REL_WHEEL:
                wheel += value
            elif code == REL_HWHEEL:
                horizontal_wheel += value
            elif code == REL_WHEEL_HI_RES:
                wheel_hi_res += value
            elif code == REL_HWHEEL_HI_RES:
                horizontal_hi_res += value

    if include_movement and (relative_x or relative_y):
        actions.append(f"mouse dx={relative_x:+d} dy={relative_y:+d}")
    if wheel:
        actions.append(f"wheel {wheel:+d}")
    elif wheel_hi_res:
        actions.append(f"wheel-hires {wheel_hi_res:+d}")
    if horizontal_wheel:
        actions.append(f"horizontal-wheel {horizontal_wheel:+d}")
    elif horizontal_hi_res:
        actions.append(f"horizontal-wheel-hires {horizontal_hi_res:+d}")
    return actions


def write_inputs_report(value, include_movement, print_report):
    path = resolve_recording(value)
    names = key_names()
    press_counts = collections.Counter()
    movement_frames = 0
    movement_counts = 0
    wheel_steps = 0
    duration_ns = 0

    with open_recording(path) as (header, handle):
        for frame in input_frames(handle):
            frame_has_movement = False
            frame_movement = 0
            frame_wheel = 0
            frame_hires_wheel = 0
            for timestamp_ns, _device, event_type, code, event_value in frame:
                duration_ns = max(duration_ns, timestamp_ns)
                if event_type == EV_KEY and event_value == 1:
                    press_counts[names.get(code, f"key-{code}")] += 1
                elif event_type == EV_REL and code in (REL_X, REL_Y):
                    frame_has_movement = True
                    frame_movement += abs(event_value)
                elif event_type == EV_REL and code in (REL_WHEEL, REL_HWHEEL):
                    frame_wheel += abs(event_value)
                elif event_type == EV_REL and code in (
                    REL_WHEEL_HI_RES,
                    REL_HWHEEL_HI_RES,
                ):
                    frame_hires_wheel += abs(event_value)
            if frame_has_movement:
                movement_frames += 1
                movement_counts += frame_movement
            wheel_steps += frame_wheel or round(frame_hires_wheel / 120)

    output_path = path.with_suffix(".inputs.txt")
    with output_path.open("w", encoding="utf-8") as output:
        output_path.chmod(0o600)
        output.write(f"Recording: {path.name}\n")
        output.write(f"Started: {header.get('started_at', 'unknown')}\n")
        output.write(f"Duration: {format_offset(duration_ns)}\n")
        output.write("Automatic key-repeat events: omitted\n")
        output.write(
            f"Mouse movement: {movement_frames} frames, "
            f"{movement_counts} raw counts\n"
        )
        output.write(f"Wheel movement: {wheel_steps} steps\n")
        output.write("\nPress counts:\n")
        if press_counts:
            for name, count in press_counts.most_common():
                output.write(f"  {name}: {count}\n")
        else:
            output.write("  none\n")
        output.write("\nTimeline:\n")

        with open_recording(path) as (_header, handle):
            for frame in input_frames(handle):
                actions = input_actions(frame, names, include_movement)
                if not actions:
                    continue
                timestamp_ns = max(event[0] for event in frame)
                output.write(
                    f"{format_offset(timestamp_ns)}  " + "; ".join(actions) + "\n"
                )

    print(f"Created: {output_path}")
    print(
        f"Presses: {sum(press_counts.values())}; "
        f"mouse frames: {movement_frames}; wheel steps: {wheel_steps}"
    )
    if print_report:
        print("")
        with output_path.open("r", encoding="utf-8") as output:
            for line in output:
                print(line, end="")
    return 0


def recording_summary(path):
    metadata = read_json(path.with_suffix(".meta.json")) or {}
    duration = int(metadata.get("duration_ns", 0))
    events = metadata.get("events", "?")
    return f"{path.name}  {format_offset(duration)}  {events} events"


def list_recordings():
    ensure_directories()
    recordings = sorted(RECORDINGS_DIR.glob("*.irec"), key=lambda p: p.stat().st_mtime_ns)
    if not recordings:
        print("No recordings yet")
        return 0
    for path in recordings:
        print(recording_summary(path))
    return 0


def emergency_monitor(stop_event):
    try:
        keyboard_path = required_devices()[0][2]
        fd = os.open(keyboard_path, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
    except (OSError, RuntimeError):
        return
    buffer = bytearray()
    try:
        while not stop_event.is_set():
            readable, _, _ = select.select([fd], [], [], 0.1)
            if not readable:
                continue
            try:
                buffer.extend(os.read(fd, INPUT_EVENT.size * 64))
            except BlockingIOError:
                continue
            offset = 0
            while len(buffer) - offset >= INPUT_EVENT.size:
                _sec, _usec, event_type, code, value = INPUT_EVENT.unpack_from(buffer, offset)
                offset += INPUT_EVENT.size
                if event_type == EV_KEY and code == KEY_F12 and value == 1:
                    stop_event.set()
            if offset:
                del buffer[:offset]
    finally:
        os.close(fd)


def wait_until(target_ns, stop_event):
    while not stop_event.is_set():
        remaining = target_ns - time.monotonic_ns()
        if remaining <= 0:
            return True
        if remaining > 2_000_000:
            time.sleep((remaining - 800_000) / 1_000_000_000)
        else:
            time.sleep(0)
    return False


def dotool_commands_for_frame(frame, held_keys, held_buttons):
    commands = []
    relative_x = 0
    relative_y = 0
    wheel = 0
    horizontal_wheel = 0
    wheel_hi_res = 0
    horizontal_hi_res = 0

    for _timestamp, _device, event_type, code, value in frame:
        if event_type == EV_KEY:
            if value == 2:
                continue
            button = BUTTON_COMMANDS.get(code)
            if button:
                if value == 1:
                    commands.append(f"buttondown {button}")
                    held_buttons.add(button)
                elif value == 0:
                    commands.append(f"buttonup {button}")
                    held_buttons.discard(button)
            elif code >= BTN_LEFT:
                continue
            elif value == 1:
                commands.append(f"keydown k:{code}")
                held_keys.add(code)
            elif value == 0:
                commands.append(f"keyup k:{code}")
                held_keys.discard(code)
        elif event_type == EV_REL:
            if code == REL_X:
                relative_x += value
            elif code == REL_Y:
                relative_y += value
            elif code == REL_WHEEL:
                wheel += value
            elif code == REL_HWHEEL:
                horizontal_wheel += value
            elif code == REL_WHEEL_HI_RES:
                wheel_hi_res += value
            elif code == REL_HWHEEL_HI_RES:
                horizontal_hi_res += value

    if relative_x or relative_y:
        commands.append(f"mousemove {relative_x} {relative_y}")
    if wheel:
        commands.append(f"wheel {wheel}")
    elif wheel_hi_res:
        steps = math.trunc(wheel_hi_res / 120)
        if steps:
            commands.append(f"wheel {steps}")
    if horizontal_wheel:
        commands.append(f"hwheel {horizontal_wheel}")
    elif horizontal_hi_res:
        steps = math.trunc(horizontal_hi_res / 120)
        if steps:
            commands.append(f"hwheel {steps}")
    return commands


def validate_recording(path):
    count = 0
    duration_ns = 0
    with open_recording(path) as (_header, handle):
        for timestamp_ns, _device, _event_type, _code, _value in stored_events(handle):
            count += 1
            duration_ns = max(duration_ns, timestamp_ns)
    return count, duration_ns


def play_recording(value, speed, countdown, dry_run):
    if speed <= 0:
        raise RuntimeError("Playback speed must be greater than zero")
    path = resolve_recording(value)
    count, duration_ns = validate_recording(path)
    print(f"Recording: {path}")
    print(f"Duration: {format_offset(duration_ns)} at {speed:g}x; {count} events")
    if dry_run:
        print("Dry run passed; no input was injected")
        return 0
    if active_state(ACTIVE_FILE):
        raise RuntimeError("Stop recording before starting playback")
    if active_state(PLAYBACK_FILE):
        raise RuntimeError("Playback is already active")

    stop_event = threading.Event()
    monitor = threading.Thread(target=emergency_monitor, args=(stop_event,), daemon=True)
    monitor.start()
    dotool = subprocess.Popen(
        ["dotool"],
        stdin=subprocess.PIPE,
        text=True,
        bufsize=1,
    )
    state = {
        "pid": os.getpid(),
        "path": str(path),
        "started_wall": time.time(),
        "started_at": datetime_module.datetime.now().astimezone().isoformat(),
    }
    atomic_json(PLAYBACK_FILE, state)
    held_keys = set()
    held_buttons = set()

    def request_stop(_signum, _frame):
        stop_event.set()

    previous_sigterm = signal.signal(signal.SIGTERM, request_stop)
    previous_sigint = signal.signal(signal.SIGINT, request_stop)
    try:
        print(f"Playback starts in {countdown:g} seconds. Press F12 to abort.")
        notify("Playback armed", f"{path.name} - F12 stops playback", "critical")
        countdown_end = time.monotonic() + countdown
        while time.monotonic() < countdown_end and not stop_event.is_set():
            time.sleep(0.05)
        if stop_event.is_set():
            print("Playback cancelled")
            return 130

        dotool.stdin.write("keydelay 0\nkeyhold 1\n")
        dotool.stdin.flush()
        playback_start_ns = time.monotonic_ns()
        frame = []
        with open_recording(path) as (_header, handle):
            for event in stored_events(handle):
                frame.append(event)
                timestamp_ns, _device, event_type, code, _value = event
                if event_type != EV_SYN or code != SYN_REPORT:
                    continue
                target_ns = playback_start_ns + int(timestamp_ns / speed)
                if not wait_until(target_ns, stop_event):
                    break
                commands = dotool_commands_for_frame(frame, held_keys, held_buttons)
                frame = []
                if commands:
                    dotool.stdin.write("\n".join(commands) + "\n")
                    dotool.stdin.flush()

        if stop_event.is_set():
            print("Playback stopped by F12 or signal")
            notify("Playback stopped", path.name)
            return 130
        print("Playback finished")
        notify("Playback finished", path.name)
        return 0
    finally:
        if dotool.stdin:
            for code in sorted(held_keys):
                dotool.stdin.write(f"keyup k:{code}\n")
            for button in sorted(held_buttons):
                dotool.stdin.write(f"buttonup {button}\n")
            try:
                dotool.stdin.flush()
                dotool.stdin.close()
            except (BrokenPipeError, OSError):
                pass
        try:
            dotool.wait(timeout=2)
        except subprocess.TimeoutExpired:
            dotool.terminate()
        stop_event.set()
        monitor.join(timeout=1)
        try:
            PLAYBACK_FILE.unlink()
        except FileNotFoundError:
            pass
        signal.signal(signal.SIGTERM, previous_sigterm)
        signal.signal(signal.SIGINT, previous_sigint)


def abort_playback():
    state = active_state(PLAYBACK_FILE)
    if not state:
        print("Playback is not running")
        return 1
    os.kill(int(state["pid"]), signal.SIGTERM)
    print("Playback stop requested")
    return 0


def print_status():
    recording = active_state(ACTIVE_FILE)
    playback = active_state(PLAYBACK_FILE)
    if recording:
        age = max(0, int(time.time() - float(recording["started_wall"])))
        print(f"Recording for {age // 60}:{age % 60:02d}: {recording['path']}")
        return 0
    if playback:
        print(f"Playing: {playback['path']}")
        return 0
    print("Idle")
    return 1


def print_indicator():
    recording = active_state(ACTIVE_FILE)
    if recording:
        age = max(0, int(time.time() - float(recording["started_wall"])))
        print(f"REC {age // 60}:{age % 60:02d}")
        print("REC")
        print("#ff3333")
        return 0
    if active_state(PLAYBACK_FILE):
        print("PLAY")
        print("PLAY")
        print("#ffcc33")
    return 0


def print_devices():
    for kind, name, path in required_devices():
        print(f"{kind}: {name} ({path})")
    print("replay: dotool virtual keyboard and relative pointer")
    return 0


def build_parser():
    parser = argparse.ArgumentParser(
        description="Record and replay keyd/Jay keyboard and mouse input"
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    start = subparsers.add_parser("start", help="start recording in the background")
    start.add_argument("name", nargs="?", default="recording")

    stop = subparsers.add_parser("stop", help="stop and save the current recording")
    stop.set_defaults()

    toggle = subparsers.add_parser("toggle", help="start or stop recording")
    toggle.add_argument("name", nargs="?", default="recording")

    subparsers.add_parser("status", help="show recording/playback status")
    subparsers.add_parser("indicator", help="print i3blocks status")
    subparsers.add_parser("list", help="list saved recordings")
    subparsers.add_parser("devices", help="show capture and replay devices")
    subparsers.add_parser("abort", help="stop active playback")

    report = subparsers.add_parser("shift-report", help="show Shift holds and inputs")
    report.add_argument("recording", nargs="?", default="latest")

    inputs = subparsers.add_parser("inputs", help="export a readable input timeline")
    inputs.add_argument("recording", nargs="?", default="latest")
    inputs.add_argument("--no-movement", action="store_true")
    inputs.add_argument("--stdout", action="store_true")

    crop = subparsers.add_parser("crop", help="save only part of a recording")
    crop.add_argument("start", help="start time: seconds, M:SS, or H:MM:SS")
    crop.add_argument("end", help="end time: seconds, M:SS, or H:MM:SS")
    crop.add_argument("name", nargs="?", default="crop")
    crop.add_argument("--recording", "-r", default="latest")

    play = subparsers.add_parser("play", help="replay a recording through dotool")
    play.add_argument("recording", nargs="?", default="latest")
    play.add_argument("--speed", type=float, default=1.0)
    play.add_argument("--countdown", type=float, default=3.0)
    play.add_argument("--dry-run", action="store_true")

    internal = subparsers.add_parser("_record", help=argparse.SUPPRESS)
    internal.add_argument("path", type=Path)
    return parser


def main():
    ensure_directories()
    args = build_parser().parse_args()
    try:
        if args.command == "start":
            return start_recording(args.name)
        if args.command == "stop":
            return stop_recording()
        if args.command == "toggle":
            return toggle_recording(args.name)
        if args.command == "status":
            return print_status()
        if args.command == "indicator":
            return print_indicator()
        if args.command == "list":
            return list_recordings()
        if args.command == "devices":
            return print_devices()
        if args.command == "shift-report":
            return write_shift_report(args.recording)
        if args.command == "inputs":
            return write_inputs_report(
                args.recording, not args.no_movement, args.stdout
            )
        if args.command == "crop":
            return crop_recording(
                args.recording, args.start, args.end, args.name
            )
        if args.command == "play":
            return play_recording(
                args.recording, args.speed, max(0, args.countdown), args.dry_run
            )
        if args.command == "abort":
            return abort_playback()
        if args.command == "_record":
            return recording_worker(args.path)
    except (OSError, RuntimeError, ValueError, json.JSONDecodeError) as error:
        print(f"input-recorder: {error}", file=sys.stderr)
        notify("Input recorder error", str(error), "critical")
        return 1
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
