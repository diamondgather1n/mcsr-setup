#!/usr/bin/env bash

set -euo pipefail

readonly CARD_NAME="alsa_card.pci-0000_0d_00.6"
readonly ANALOG_PROFILE_INDEX=1
readonly EARBUDS_SINK="alsa_output.pci-0000_0d_00.6.analog-stereo"
readonly MONITOR_SINK="alsa_output.pci-0000_01_00.1.hdmi-stereo-extra2"
readonly HEADPHONES_SINK="alsa_output.usb-Logi_USB_Headset_Logi_USB_Headset-00.analog-stereo"
readonly PROFILE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/audio-output-profiles"

usage() {
    printf 'Usage: %s earbuds|monitor|headphones|save-current\n' "${0##*/}" >&2
    exit 2
}

profile_name_for_sink() {
    case $1 in
        "$EARBUDS_SINK") printf '%s\n' earbuds ;;
        "$MONITOR_SINK") printf '%s\n' monitor ;;
        "$HEADPHONES_SINK") printf '%s\n' headphones ;;
        *) return 1 ;;
    esac
}

sink_serial() {
    pactl list short sinks | awk -v wanted="$1" '$2 == wanted { print $1; exit }'
}

sink_profile_row() {
    pactl list sinks | awk -v wanted="$1" '
        /^Sink #[0-9]+/ {
            active = 0
            volume = ""
            mute = ""
        }
        /^\tName:/ {
            active = ($2 == wanted)
        }
        active && /^\tMute:/ {
            mute = ($2 == "yes" ? "1" : "0")
        }
        active && /^\tVolume:/ && volume == "" {
            if (match($0, /[0-9]+%/)) {
                volume = substr($0, RSTART, RLENGTH)
            }
        }
        active && volume != "" && mute != "" {
            print volume "\t" mute
            exit
        }
    '
}

stream_profile_rows() {
    local sink_id

    sink_id=$(sink_serial "$1")
    [[ -n $sink_id ]] || return 0

    pactl list sink-inputs | awk -v wanted_sink="$sink_id" '
        function reset() {
            id = ""
            sink = ""
            restore_id = ""
            volume = ""
            mute = ""
            skip = 0
        }
        function emit() {
            if (id != "" && sink == wanted_sink && restore_id != "" &&
                volume != "" && mute != "" && !skip) {
                print restore_id "\t" volume "\t" mute
            }
        }
        BEGIN { reset() }
        /^Sink Input #[0-9]+/ {
            emit()
            reset()
            id = $3
            sub(/^#/, "", id)
            next
        }
        /^\tSink:/ { sink = $2 }
        /^\tMute:/ { mute = ($2 == "yes" ? "1" : "0") }
        /^\tVolume:/ && volume == "" {
            if (match($0, /[0-9]+%/)) {
                volume = substr($0, RSTART, RLENGTH)
            }
        }
        /module-stream-restore\.id = "/ {
            restore_id = $0
            sub(/^.*module-stream-restore\.id = "/, "", restore_id)
            sub(/".*$/, "", restore_id)
        }
        /node\.virtual = "true"/ { skip = 1 }
        /node\.name = "audiorelay_source"/ { skip = 1 }
        /target\.object = "(Intermediate-Chromebook-Mic|Laptop-Speaker)"/ { skip = 1 }
        END { emit() }
    '
}

matching_stream_ids() {
    local sink_id=$1 restore_key=$2

    pactl list sink-inputs | awk -v wanted_sink="$sink_id" -v wanted_key="$restore_key" '
        function reset() {
            id = ""
            sink = ""
            restore_id = ""
            skip = 0
        }
        function emit() {
            if (id != "" && sink == wanted_sink && restore_id == wanted_key && !skip) {
                print id
            }
        }
        BEGIN { reset() }
        /^Sink Input #[0-9]+/ {
            emit()
            reset()
            id = $3
            sub(/^#/, "", id)
            next
        }
        /^\tSink:/ { sink = $2 }
        /module-stream-restore\.id = "/ {
            restore_id = $0
            sub(/^.*module-stream-restore\.id = "/, "", restore_id)
            sub(/".*$/, "", restore_id)
        }
        /node\.virtual = "true"/ { skip = 1 }
        /node\.name = "audiorelay_source"/ { skip = 1 }
        /target\.object = "(Intermediate-Chromebook-Mic|Laptop-Speaker)"/ { skip = 1 }
        END { emit() }
    '
}

save_output_profile() {
    local sink_name=$1 profile profile_file settings sink_volume sink_mute
    local kind key volume mute tmp
    declare -A volumes=() mutes=()

    if ! profile=$(profile_name_for_sink "$sink_name"); then
        return 0
    fi

    settings=$(sink_profile_row "$sink_name")
    [[ -n $settings ]] || return 0
    IFS=$'\t' read -r sink_volume sink_mute <<< "$settings"

    mkdir -p "$PROFILE_DIR"
    profile_file="$PROFILE_DIR/$profile.tsv"

    if [[ -r $profile_file ]]; then
        while IFS=$'\t' read -r kind key volume mute; do
            [[ $kind == stream && -n $key ]] || continue
            volumes["$key"]=$volume
            mutes["$key"]=$mute
        done < "$profile_file"
    fi

    while IFS=$'\t' read -r key volume mute; do
        [[ -n $key ]] || continue
        volumes["$key"]=$volume
        mutes["$key"]=$mute
    done < <(stream_profile_rows "$sink_name")

    tmp=$(mktemp "$PROFILE_DIR/.${profile}.XXXXXX")
    {
        printf 'sink\t%s\t%s\t%s\n' "$sink_name" "$sink_volume" "$sink_mute"
        while IFS= read -r key; do
            [[ -n $key ]] || continue
            printf 'stream\t%s\t%s\t%s\n' "$key" "${volumes[$key]}" "${mutes[$key]}"
        done < <(printf '%s\n' "${!volumes[@]}" | LC_ALL=C sort)
    } > "$tmp"
    mv -f -- "$tmp" "$profile_file"
}

apply_output_profile() {
    local sink_name=$1 profile profile_file sink_id
    local kind key volume mute input_id

    if ! profile=$(profile_name_for_sink "$sink_name"); then
        return 0
    fi

    profile_file="$PROFILE_DIR/$profile.tsv"
    [[ -r $profile_file ]] || return 0

    sink_id=$(sink_serial "$sink_name")
    [[ -n $sink_id ]] || return 0

    while IFS=$'\t' read -r kind key volume mute; do
        case $kind in
            sink)
                pactl set-sink-volume "$sink_name" "$volume"
                pactl set-sink-mute "$sink_name" "$mute"
                ;;
            stream)
                while read -r input_id; do
                    [[ -n $input_id ]] || continue
                    pactl set-sink-input-volume "$input_id" "$volume" || continue
                    pactl set-sink-input-mute "$input_id" "$mute" || true
                done < <(matching_stream_ids "$sink_id" "$key")
                ;;
        esac
    done < "$profile_file"
}

node_id() {
    local target=$1

    wpctl status -n | awk -v target="$target" '
        !found && index($0, target) {
            for (i = 1; i <= NF; i++) {
                if ($i ~ /^[0-9]+\.$/) {
                    sub(/\.$/, "", $i)
                    print $i
                    found = 1
                    break
                }
            }
        }
    '
}

ensure_earbuds_sink() {
    local card_id

    for _ in {1..50}; do
        card_id=$(node_id "$CARD_NAME")
        [[ -n $card_id ]] && break
        sleep 0.1
    done

    if [[ -z $card_id ]]; then
        printf 'Audio card not found: %s\n' "$CARD_NAME" >&2
        exit 1
    fi

    wpctl set-profile "$card_id" "$ANALOG_PROFILE_INDEX"

    for _ in {1..30}; do
        if pactl list short sinks | grep -Fq "$EARBUDS_SINK"; then
            pactl set-sink-port "$EARBUDS_SINK" analog-output-lineout
            return
        fi
        sleep 0.1
    done

    printf 'Analog output did not appear: %s\n' "$EARBUDS_SINK" >&2
    exit 1
}

move_playing_audio() {
    local sink=$1 input_id

    while read -r input_id; do
        [[ -n $input_id ]] && pactl move-sink-input "$input_id" "$sink"
    done < <(
        pactl list sink-inputs | awk '
            /^Sink Input #[0-9]+/ {
                if (id && !protected) print id
                id = $3
                sub(/^#/, "", id)
                protected = 0
                next
            }
            /target\.object = "(Intermediate-Chromebook-Mic|Laptop-Speaker)"/ {
                protected = 1
            }
            END {
                if (id && !protected) print id
            }
        '
    )
}

disable_stream_target_restore() {
    wpctl settings node.stream.restore-target false -s >/dev/null
}

current_sink=$(pactl get-default-sink 2>/dev/null || true)

if [[ ${1:-} == save-current ]]; then
    [[ -n $current_sink ]] || {
        printf 'No default audio output found\n' >&2
        exit 1
    }
    save_output_profile "$current_sink"
    printf 'Saved audio profile: %s\n' "$(profile_name_for_sink "$current_sink")"
    exit 0
fi

[[ -n $current_sink ]] && save_output_profile "$current_sink"

case ${1:-} in
    earbuds)
        ensure_earbuds_sink
        sink=$EARBUDS_SINK
        label="Earbuds"
        mic_mode=earbuds
        ;;
    monitor)
        sink=$MONITOR_SINK
        label="Monitor speakers"
        ;;
    headphones)
        sink=$HEADPHONES_SINK
        label="Headphones"
        mic_mode=headphones
        ;;
    *) usage ;;
esac

disable_stream_target_restore

sink_id=$(node_id "$sink")
if [[ -z $sink_id ]]; then
    printf 'Audio output not found: %s\n' "$sink" >&2
    exit 1
fi

wpctl set-default "$sink_id"
move_playing_audio "$sink"
apply_output_profile "$sink"
if [[ -n ${mic_mode:-} ]]; then
    "$HOME/.local/bin/obs-mic-switch" "$mic_mode"
fi
printf 'Audio output: %s\n' "$label"
