#!/usr/bin/env python3
"""Enforce dedicated application and microphone links to OBS audio inputs."""

import argparse
import json
import os
import select
import subprocess
import time
from pathlib import Path


PW_DUMP = "/usr/bin/pw-dump"
PW_LINK = "/usr/bin/pw-link"
DEFAULT_INTERVAL = 30.0
EVENT_DEBOUNCE = 0.2
COMMAND_TIMEOUT = 3
REMOVE_UNMANAGED_LINKS = False

ROUTES = (
    {
        "name": "Minecraft",
        "matcher": "minecraft",
        "target": "Desktop Audio 2",
    },
    {
        "name": "Spotify",
        "matcher": "spotify",
        "target": "Desktop Audio",
    },
)

MINECRAFT_CMDLINE_MARKERS = (
    b"net.minecraft",
    b"com/mojang/minecraft",
    b"minecraft-",
    b"moonsworth.lunar",
    b".lunarclient/",
)


def object_properties(pipewire_object):
    return pipewire_object.get("info", {}).get("props", {})


def integer_property(properties, *names):
    for name in names:
        try:
            return int(properties.get(name))
        except (TypeError, ValueError):
            continue
    return None


def read_snapshot():
    result = subprocess.run(
        [PW_DUMP, "-N"],
        check=True,
        capture_output=True,
        text=True,
        timeout=COMMAND_TIMEOUT,
    )
    return json.loads(result.stdout)


def build_graph(snapshot):
    clients = {}
    nodes = {}
    ports_by_node = {}
    links = {}

    for pipewire_object in snapshot:
        object_type = pipewire_object.get("type", "")
        object_id = pipewire_object.get("id")
        properties = object_properties(pipewire_object)

        if object_type.endswith(":Client"):
            clients[object_id] = properties
        elif object_type.endswith(":Node"):
            nodes[object_id] = properties
        elif object_type.endswith(":Port"):
            node_id = integer_property(properties, "node.id")
            if node_id is None:
                continue
            ports_by_node.setdefault(node_id, []).append(
                {
                    "id": object_id,
                    "direction": pipewire_object.get("info", {}).get(
                        "direction",
                        properties.get("port.direction"),
                    ),
                    "channel": properties.get("audio.channel"),
                }
            )
        elif object_type.endswith(":Link"):
            output_port = integer_property(properties, "link.output.port")
            input_port = integer_property(properties, "link.input.port")
            if output_port is not None and input_port is not None:
                links[(output_port, input_port)] = {
                    "id": object_id,
                    "output_node": integer_property(
                        properties,
                        "link.output.node",
                    ),
                    "input_node": integer_property(
                        properties,
                        "link.input.node",
                    ),
                }

    return clients, nodes, ports_by_node, links


def combined_node_properties(node_properties, clients):
    client_id = integer_property(node_properties, "client.id")
    properties = dict(clients.get(client_id, {}))
    properties.update(node_properties)
    return properties


def is_audio_output(properties):
    return properties.get("media.class") == "Stream/Output/Audio"


def process_cmdline(properties):
    pid = integer_property(
        properties,
        "application.process.id",
        "pipewire.sec.pid",
    )
    if pid is None:
        return b""
    try:
        return Path(f"/proc/{pid}/cmdline").read_bytes().lower()
    except OSError:
        return b""


def is_minecraft(properties):
    if not is_audio_output(properties):
        return False

    identity = " ".join(
        str(properties.get(name, ""))
        for name in (
            "application.name",
            "application.process.binary",
            "node.name",
            "node.description",
            "media.name",
        )
    ).casefold()
    if "minecraft" in identity or "lunar client" in identity:
        return True

    java_stream = (
        properties.get("application.process.binary") == "java"
        or properties.get("node.name") == "java"
    )
    if not java_stream:
        return False

    cmdline = process_cmdline(properties)
    return any(marker in cmdline for marker in MINECRAFT_CMDLINE_MARKERS)


def is_spotify(properties):
    if not is_audio_output(properties):
        return False

    identifiers = (
        properties.get("application.name"),
        properties.get("application.process.binary"),
        properties.get("node.name"),
        properties.get("media.name"),
    )
    return any(
        str(identifier or "").casefold() == "spotify"
        for identifier in identifiers
    )


def is_chromebook_mic(properties):
    if properties.get("media.class") != "Audio/Source":
        return False

    identifiers = (
        properties.get("node.name"),
        properties.get("node.description"),
        properties.get("media.name"),
    )
    return any(
        str(identifier or "").casefold() == "chromebook-mic"
        for identifier in identifiers
    )


def is_obs_target(properties, media_name):
    return (
        properties.get("media.class") == "Stream/Input/Audio"
        and properties.get("application.process.binary") == "obs"
        and properties.get("media.name") == media_name
    )


def channel_ports(ports, direction):
    return {
        port["channel"]: port["id"]
        for port in ports
        if port["direction"] == direction and port["channel"] in {"FL", "FR"}
    }


def link_ports(output_port, input_port):
    return subprocess.run(
        [PW_LINK, "-w", str(output_port), str(input_port)],
        capture_output=True,
        text=True,
        timeout=COMMAND_TIMEOUT,
    )


def unlink(link_id):
    return subprocess.run(
        [PW_LINK, "-d", str(link_id)],
        capture_output=True,
        text=True,
        timeout=COMMAND_TIMEOUT,
    )


def route_matcher(name):
    return {
        "minecraft": is_minecraft,
        "spotify": is_spotify,
        "chromebook-mic": is_chromebook_mic,
    }[name]


def node_label(properties):
    for name in (
        "node.description",
        "application.name",
        "node.name",
        "media.name",
    ):
        value = properties.get(name)
        if value:
            return str(value)
    return "unknown source"


def reconcile(dry_run=False, verbose=False):
    snapshot = read_snapshot()
    clients, nodes, ports_by_node, links = build_graph(snapshot)
    resolved_nodes = {
        node_id: combined_node_properties(properties, clients)
        for node_id, properties in nodes.items()
    }
    changes = 0

    for route in ROUTES:
        matcher = route_matcher(route["matcher"])
        sources = [
            node_id
            for node_id, properties in resolved_nodes.items()
            if matcher(properties)
        ]
        targets = [
            node_id
            for node_id, properties in resolved_nodes.items()
            if is_obs_target(properties, route["target"])
        ]
        existing = 0
        missing = 0
        unwanted = 0
        desired_links = {}

        for source_node in sources:
            output_ports = channel_ports(
                ports_by_node.get(source_node, []),
                "output",
            )
            for target_node in targets:
                input_ports = channel_ports(
                    ports_by_node.get(target_node, []),
                    "input",
                )
                for channel in sorted(output_ports.keys() & input_ports.keys()):
                    link = (output_ports[channel], input_ports[channel])
                    desired_links[link] = {
                        "channel": channel,
                        "source_node": source_node,
                        "target_node": target_node,
                    }

        if REMOVE_UNMANAGED_LINKS:
            target_nodes = set(targets)
            for link, link_info in list(links.items()):
                if (
                    link_info["input_node"] not in target_nodes
                    or link in desired_links
                ):
                    continue

                unwanted += 1
                source = node_label(
                    resolved_nodes.get(link_info["output_node"], {})
                )
                if dry_run:
                    print(
                        f"Would disconnect {source} from "
                        f"OBS [{route['target']}]",
                        flush=True,
                    )
                    continue

                result = unlink(link_info["id"])
                error = (result.stderr or result.stdout).strip()
                if result.returncode == 0:
                    links.pop(link, None)
                    changes += 1
                    print(
                        f"Disconnected {source} from "
                        f"OBS [{route['target']}]",
                        flush=True,
                    )
                elif "No such file" not in error and "not found" not in error:
                    print(
                        f"Could not disconnect {source} from "
                        f"OBS [{route['target']}]: "
                        f"{error or 'unknown pw-link error'}",
                        flush=True,
                    )

        for link, desired in desired_links.items():
            if link in links:
                existing += 1
                continue

            missing += 1
            if dry_run:
                print(
                    f"Would link {route['name']} {desired['channel']} "
                    f"to OBS [{route['target']}]",
                    flush=True,
                )
                continue

            result = link_ports(*link)
            error = (result.stderr or result.stdout).strip()
            if result.returncode == 0:
                links[link] = {
                    "id": None,
                    "output_node": desired["source_node"],
                    "input_node": desired["target_node"],
                }
                changes += 1
                print(
                    f"Linked {route['name']} {desired['channel']} "
                    f"to OBS [{route['target']}]",
                    flush=True,
                )
            elif "File exists" not in error:
                print(
                    f"Could not link {route['name']} "
                    f"{desired['channel']}: "
                    f"{error or 'unknown pw-link error'}",
                    flush=True,
                )

        if verbose:
            print(
                f"{route['name']}: {len(sources)} source(s), "
                f"{len(targets)} OBS target(s), "
                f"{existing} existing link(s), "
                f"{missing} missing link(s), "
                f"{unwanted} unwanted link(s)",
                flush=True,
            )

    return changes


def parse_args():
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="report missing links without creating them",
    )
    parser.add_argument(
        "--once",
        action="store_true",
        help="reconcile once instead of running continuously",
    )
    parser.add_argument(
        "--verbose",
        action="store_true",
        help="report matched sources, targets, and existing links",
    )
    parser.add_argument(
        "--interval",
        type=float,
        default=DEFAULT_INTERVAL,
        help="maximum seconds between safety checks",
    )
    return parser.parse_args()


def reconcile_safely(args, pipewire_was_unavailable):
    try:
        reconcile(args.dry_run, args.verbose)
        if pipewire_was_unavailable:
            print("PipeWire connection restored", flush=True)
        return False
    except (
        json.JSONDecodeError,
        OSError,
        subprocess.SubprocessError,
    ) as error:
        if not pipewire_was_unavailable:
            print(f"Waiting for PipeWire: {error}", flush=True)
        return True


def monitor_graph(args):
    pipewire_was_unavailable = False

    while True:
        pipewire_was_unavailable = reconcile_safely(
            args,
            pipewire_was_unavailable,
        )
        monitor = subprocess.Popen(
            [PW_LINK, "-l", "-m"],
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            bufsize=0,
        )

        try:
            output_fd = monitor.stdout.fileno()
            os.set_blocking(output_fd, False)
            next_safety_check = time.monotonic() + args.interval
            event_deadline = None

            while monitor.poll() is None:
                deadlines = [next_safety_check]
                if event_deadline is not None:
                    deadlines.append(event_deadline)
                timeout = max(0.0, min(deadlines) - time.monotonic())
                readable, _writable, _errors = select.select(
                    [output_fd],
                    [],
                    [],
                    timeout,
                )

                if readable:
                    event_data = os.read(output_fd, 65536)
                    if not event_data:
                        break
                    event_deadline = time.monotonic() + EVENT_DEBOUNCE

                now = time.monotonic()
                if event_deadline is not None and now >= event_deadline:
                    pipewire_was_unavailable = reconcile_safely(
                        args,
                        pipewire_was_unavailable,
                    )
                    event_deadline = None
                    next_safety_check = now + args.interval
                elif now >= next_safety_check:
                    pipewire_was_unavailable = reconcile_safely(
                        args,
                        pipewire_was_unavailable,
                    )
                    next_safety_check = now + args.interval
        finally:
            if monitor.poll() is None:
                monitor.terminate()
            try:
                monitor.wait(timeout=1)
            except subprocess.TimeoutExpired:
                monitor.kill()
                monitor.wait()

        time.sleep(1)


def main():
    args = parse_args()
    if args.interval <= 0:
        raise SystemExit("--interval must be greater than zero")

    if args.once:
        reconcile(args.dry_run, args.verbose)
        return

    print("OBS audio autolink started", flush=True)
    monitor_graph(args)


if __name__ == "__main__":
    main()
