#!/usr/bin/env bash
set -Eeuo pipefail

left="${1:-$PWD}"
right="${2:-$left}"
doublecmd_bin=""

for candidate in doublecmd doublecmd-qt6 doublecmd-qt; do
  if command -v "$candidate" >/dev/null 2>&1; then
    doublecmd_bin="$candidate"
    break
  fi
done

if [ -z "$doublecmd_bin" ]; then
  echo "Double Commander is not installed. Run /home/nathan/MCSR/temp/install-terminal-file-workflow.sh first." >&2
  exit 127
fi

exec "$doublecmd_bin" -C -L "$left" -R "$right"
