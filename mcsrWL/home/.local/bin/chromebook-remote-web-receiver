  <script>
    const startButton = document.getElementById("start");
    const stopButton = document.getElementById("stop");
    const statusEl = document.getElementById("status");
    const pad = document.getElementById("pad");
    const fullscreenPad = document.getElementById("fullscreenPad");
    const preview = document.getElementById("preview");
    const previewStatus = document.getElementById("previewStatus");
    const sceneSelect = document.getElementById("sceneSelect");
    const sceneStatus = document.getElementById("sceneStatus");
    const target = document.getElementById("target");
    const selectionBox = document.getElementById("selectionBox");
    const controlStatus = document.getElementById("controlStatus");
    const connection = document.getElementById("connection");
    const connectionText = document.getElementById("connectionText");
    const token = new URLSearchParams(location.search).get("token") || "";

    let previewTimer;
    let previewObjectUrl;
    const previewFrameInterval = 1000 / 20;

    function apiUrl(path) {
      return `${path}?token=${encodeURIComponent(token)}`;
    }

    function setSceneStatus(text, error = false) {
      sceneStatus.textContent = text;
      sceneStatus.classList.toggle("error", error);
    }

    async function loadScenes() {
      try {
        const response = await fetch(apiUrl("/obs-scenes"), { cache: "no-store" });
        if (!response.ok) throw new Error(`scene list HTTP ${response.status}`);
        const data = await response.json();
        const scenes = Array.isArray(data.scenes) ? data.scenes : [];
        const current = data.current || "where its at";
        sceneSelect.replaceChildren();
        for (const name of scenes) {
          const option = new Option(name, name);
          option.selected = name === current;
          sceneSelect.add(option);
        }
        if (!scenes.length) {
          sceneSelect.add(new Option(current, current, true, true));
        }
        setSceneStatus(current);
      } catch (error) {
        console.error(error);
        setSceneStatus("OBS unavailable", true);
      }
    }

    sceneSelect.addEventListener("change", async () => {
      const scene = sceneSelect.value;
      sceneSelect.disabled = true;
      setSceneStatus("Switching...");
      try {
        const response = await fetch("/obs-scene", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ token, scene }),
        });
        if (!response.ok) throw new Error(`scene switch HTTP ${response.status}`);
        setSceneStatus(`Preview: ${scene}`);
        previewStatus.hidden = false;
        previewStatus.textContent = `Loading ${scene}...`;
      } catch (error) {
        console.error(error);
        setSceneStatus("Switch failed", true);
        await loadScenes();
      } finally {
        sceneSelect.disabled = false;
      }
    });

    loadScenes();

    function previewUrl() {
      return `/obs-preview.jpg?token=${encodeURIComponent(token)}&t=${Date.now()}`;
    }

    function schedulePreview(delay) {
      clearTimeout(previewTimer);
      previewTimer = setTimeout(refreshPreview, delay);
    }

    async function refreshPreview() {
      if (document.hidden) {
        return;
      }
      const frameStartedAt = performance.now();
      try {
        const response = await fetch(previewUrl(), { cache: "no-store" });
        if (!response.ok) {
          throw new Error(`preview HTTP ${response.status}`);
        }
        const blob = await response.blob();
        const nextUrl = URL.createObjectURL(blob);
        await new Promise((resolve, reject) => {
          preview.onload = resolve;
          preview.onerror = reject;
          preview.src = nextUrl;
        });
        const previousUrl = previewObjectUrl;
        previewObjectUrl = nextUrl;
        preview.classList.add("ready");
        previewStatus.hidden = true;
        if (previousUrl) {
          URL.revokeObjectURL(previousUrl);
        }
        schedulePreview(Math.max(0, previewFrameInterval - (performance.now() - frameStartedAt)));
      } catch (error) {
        console.error(error);
        previewStatus.textContent = "OBS preview unavailable.";
        previewStatus.hidden = false;
        schedulePreview(1000);
      }
    }

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        clearTimeout(previewTimer);
      } else {
        refreshPreview();
      }
    });
    refreshPreview();

    let micSocket;
    let micContext;
    let stream;
    let source;
    let node;
    let mute;
    let flushTimer;
    let pending = [];
    let pendingBytes = 0;
    const flushMicBytes = 1024;
    const maxMicSocketBytes = 4800;

    function setStatus(text) {
      statusEl.textContent = text;
    }

    function socketUrl() {
      const scheme = location.protocol === "https:" ? "wss:" : "ws:";
      return `${scheme}//${location.host}/audio`;
    }

    function speakerUrl() {
      const scheme = location.protocol === "https:" ? "wss:" : "ws:";
      return `${scheme}//${location.host}/speaker?token=${encodeURIComponent(token)}`;
    }

    function controlUrl() {
      const scheme = location.protocol === "https:" ? "wss:" : "ws:";
      return `${scheme}//${location.host}/control?token=${encodeURIComponent(token)}`;
    }

    function flushAudio() {
      if (!micSocket || micSocket.readyState !== WebSocket.OPEN || pendingBytes === 0) {
        return;
      }
      if (micSocket.bufferedAmount > maxMicSocketBytes) {
        pending = [];
        pendingBytes = 0;
        return;
      }
      const out = new Uint8Array(pendingBytes);
      let offset = 0;
      for (const chunk of pending) {
        out.set(chunk, offset);
        offset += chunk.byteLength;
      }
      pending = [];
      pendingBytes = 0;
      micSocket.send(out.buffer);
    }

    async function startMic() {
      startButton.disabled = true;
      setStatus("Opening microphone...");

      micSocket = new WebSocket(socketUrl());
      micSocket.binaryType = "arraybuffer";
      await new Promise((resolve, reject) => {
        micSocket.onopen = resolve;
        micSocket.onerror = reject;
      });

      stream = await navigator.mediaDevices.getUserMedia({
        audio: {
          channelCount: 1,
          sampleRate: { ideal: 48000 },
          latency: { ideal: 0.01 },
          echoCancellation: false,
          noiseSuppression: false,
          autoGainControl: false
        }
      });

      micContext = new AudioContext({
        latencyHint: "interactive",
        sampleRate: 48000,
      });
      await micContext.audioWorklet.addModule("/mic-worklet.js");

      micSocket.send(JSON.stringify({
        sampleRate: micContext.sampleRate,
        channels: 1,
        format: "s16le"
      }));

      source = micContext.createMediaStreamSource(stream);
      node = new AudioWorkletNode(micContext, "mic-processor", {
        numberOfInputs: 1,
        numberOfOutputs: 1,
        outputChannelCount: [1],
      });
      node.port.onmessage = (event) => {
        const chunk = new Uint8Array(event.data);
        pending.push(chunk);
        pendingBytes += chunk.byteLength;
        if (pendingBytes >= flushMicBytes) {
          flushAudio();
        }
      };

      mute = micContext.createGain();
      mute.gain.value = 0;
      source.connect(node);
      node.connect(mute);
      mute.connect(micContext.destination);

      flushTimer = setInterval(flushAudio, 10);
      stopButton.disabled = false;
      setStatus(`Chromebook mic streaming at ${micContext.sampleRate} Hz.`);
    }

    async function stopMic() {
      stopButton.disabled = true;
      if (flushTimer) {
        clearInterval(flushTimer);
        flushTimer = undefined;
      }
      flushAudio();
      if (source) source.disconnect();
      if (node) node.disconnect();
      if (mute) mute.disconnect();
      if (stream) stream.getTracks().forEach((track) => track.stop());
      if (micContext) await micContext.close();
      if (micSocket && micSocket.readyState === WebSocket.OPEN) micSocket.close();
      source = node = mute = stream = micContext = micSocket = undefined;
      pending = [];
      pendingBytes = 0;
      startButton.disabled = false;
      setStatus("Stopped.");
    }

    startButton.addEventListener("click", () => {
      startMic().catch((error) => {
        console.error(error);
        setStatus(error.message || String(error));
        startButton.disabled = false;
        stopButton.disabled = true;
      });
    });
    stopButton.addEventListener("click", () => {
      stopMic().catch((error) => setStatus(error.message || String(error)));
    });

    let speakerSocket;
    let speakerContext;
    let speakerNode;

    function setSpeakerStatus(text) {
      document.getElementById("speakerStatus").textContent = text;
    }

    async function startSpeaker() {
      const start = document.getElementById("speakerStart");
      const stop = document.getElementById("speakerStop");
      start.disabled = true;
      setSpeakerStatus("Opening PC audio receiver...");

      speakerContext = new AudioContext({
        latencyHint: "interactive",
        sampleRate: 48000,
      });
      await speakerContext.audioWorklet.addModule("/speaker-worklet.js");
      speakerNode = new AudioWorkletNode(speakerContext, "speaker-player", {
        numberOfInputs: 0,
        numberOfOutputs: 1,
        outputChannelCount: [2],
      });
      speakerNode.connect(speakerContext.destination);
      await speakerContext.resume();

      speakerSocket = new WebSocket(speakerUrl());
      speakerSocket.binaryType = "arraybuffer";
      speakerSocket.onmessage = (event) => {
        if (speakerNode) {
          speakerNode.port.postMessage(event.data, [event.data]);
        }
      };
      speakerSocket.onopen = () => {
        stop.disabled = false;
        setSpeakerStatus('PC audio receiver enabled. Route audio to "Laptop-Speaker" in qpwgraph.');
      };
      speakerSocket.onerror = () => setSpeakerStatus("PC audio receiver connection failed.");
      speakerSocket.onclose = () => {
        stop.disabled = true;
        if (speakerNode) speakerNode.disconnect();
        if (speakerContext) speakerContext.close().catch(() => {});
        speakerSocket = speakerNode = speakerContext = undefined;
        start.disabled = false;
        setSpeakerStatus("PC audio receiver stopped.");
      };
    }

    async function stopSpeaker() {
      const start = document.getElementById("speakerStart");
      const stop = document.getElementById("speakerStop");
      stop.disabled = true;
      if (speakerSocket && speakerSocket.readyState === WebSocket.OPEN) speakerSocket.close();
      if (speakerNode) speakerNode.disconnect();
      if (speakerContext) await speakerContext.close();
      speakerSocket = speakerNode = speakerContext = undefined;
      start.disabled = false;
      setSpeakerStatus("Laptop speaker idle.");
    }

    document.getElementById("speakerStart").addEventListener("click", () => {
      startSpeaker().catch((error) => {
        console.error(error);
        setSpeakerStatus(error.message || String(error));
        document.getElementById("speakerStart").disabled = false;
      });
    });
    document.getElementById("speakerStop").addEventListener("click", () => {
      stopSpeaker().catch((error) => setSpeakerStatus(error.message || String(error)));
    });

    let controlSocket;
    let cursorMovementEnabled = true;
    let activePadPointer;
    let movementAtPointerDown;
    let queuedPadPoint;
    let padMoveFrame;
    let selectionMode = false;
    let selectionStart;

    function setControlStatus(text) {
      controlStatus.textContent = text;
    }

    function setConnectionState(online, text) {
      connection.classList.toggle("online", online);
      connectionText.textContent = text;
    }

    function connectControl() {
      if (!token) {
        setConnectionState(false, "Token missing");
        setControlStatus("Remote input token missing");
        return;
      }
      if (controlSocket && (
        controlSocket.readyState === WebSocket.OPEN ||
        controlSocket.readyState === WebSocket.CONNECTING
      )) {
        return;
      }
      setConnectionState(false, "Connecting");
      controlSocket = new WebSocket(controlUrl());
      controlSocket.onopen = () => {
        setConnectionState(true, "Connected");
        setControlStatus("Remote input ready");
      };
      controlSocket.onerror = () => {
        setConnectionState(false, "Connection error");
        setControlStatus("Remote input connection failed");
      };
      controlSocket.onclose = () => {
        controlSocket = undefined;
        setConnectionState(false, "Reconnecting");
        setTimeout(connectControl, 1000);
      };
    }

    function controlSend(message) {
      if (!controlSocket || controlSocket.readyState !== WebSocket.OPEN) {
        connectControl();
        setControlStatus("Remote input reconnecting");
        return;
      }
      controlSocket.send(JSON.stringify(message));
    }

    function padPoint(event) {
      const rect = pad.getBoundingClientRect();
      const x = Math.max(0, Math.min(1, (event.clientX - rect.left) / rect.width));
      const y = Math.max(0, Math.min(1, (event.clientY - rect.top) / rect.height));
      return { x, y };
    }

    function showTarget(point) {
      target.classList.add("visible");
      target.style.left = `${point.x * 100}%`;
      target.style.top = `${point.y * 100}%`;
    }

    function showSelection(start, end = start) {
      const left = Math.min(start.x, end.x) * 100;
      const top = Math.min(start.y, end.y) * 100;
      const width = Math.abs(start.x - end.x) * 100;
      const height = Math.abs(start.y - end.y) * 100;
      selectionBox.style.left = `${left}%`;
      selectionBox.style.top = `${top}%`;
      selectionBox.style.width = `${Math.max(width, 0.4)}%`;
      selectionBox.style.height = `${Math.max(height, 0.4)}%`;
      selectionBox.classList.add("visible");
    }

    function updateSelectionButton() {
      const button = document.getElementById("selectText");
      button.textContent = selectionMode ? "Cancel selection" : "Select between points";
      button.classList.toggle("off", selectionMode);
    }

    function queueCursorMove(point) {
      queuedPadPoint = point;
      showTarget(point);
      if (padMoveFrame) return;

      padMoveFrame = requestAnimationFrame(() => {
        const nextPoint = queuedPadPoint;
        queuedPadPoint = undefined;
        padMoveFrame = undefined;
        if (nextPoint) {
          controlSend({ type: "move", x: nextPoint.x, y: nextPoint.y });
        }
      });
    }

    function updateMovementToggle() {
      const button = document.getElementById("moveToggle");
      button.textContent = cursorMovementEnabled ? "Move: On" : "Move: Off";
      button.classList.toggle("off", !cursorMovementEnabled);
      button.setAttribute("aria-pressed", String(cursorMovementEnabled));
      document.querySelector(".gesture-hint").textContent = cursorMovementEnabled
        ? "Move: On · move over the preview, then click to freeze · use L/R/M to act"
        : "Move: Off · cursor frozen · use L/R/M to act, then click the preview to move again";
    }

    function updateFullscreenButton() {
      const active = document.fullscreenElement === pad || document.body.classList.contains("remote-fullscreen");
      fullscreenPad.textContent = active
        ? "Exit fullscreen"
        : "Fullscreen pad";
    }

    fullscreenPad.addEventListener("click", async () => {
      try {
        if (document.fullscreenElement || document.body.classList.contains("remote-fullscreen")) {
          if (document.fullscreenElement) {
            await document.exitFullscreen();
          }
          document.body.classList.remove("remote-fullscreen");
        } else {
          try {
            if (document.documentElement.requestFullscreen) {
              await document.documentElement.requestFullscreen();
            } else if (pad.requestFullscreen) {
              await pad.requestFullscreen();
            } else {
              throw new Error("Fullscreen API unavailable");
            }
          } catch (error) {
            document.body.classList.add("remote-fullscreen");
            setControlStatus("Fullscreen fallback enabled");
          }
        }
      } catch (error) {
        setControlStatus(error.message || "Fullscreen unavailable");
      }
      updateFullscreenButton();
    });
    document.addEventListener("fullscreenchange", () => {
      if (!document.fullscreenElement) {
        document.body.classList.remove("remote-fullscreen");
      }
      updateFullscreenButton();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && document.body.classList.contains("remote-fullscreen")) {
        document.body.classList.remove("remote-fullscreen");
        updateFullscreenButton();
      }
    });

    pad.addEventListener("pointerdown", (event) => {
      event.preventDefault();
      pad.focus();
      const point = padPoint(event);
      if (selectionMode) {
        if (!selectionStart) {
          selectionStart = point;
          showSelection(point);
          controlSend({ type: "move", x: point.x, y: point.y });
          setControlStatus("Selection start set · choose the end point");
        } else {
          const start = selectionStart;
          selectionStart = undefined;
          selectionMode = false;
          showSelection(start, point);
          controlSend({ type: "select", start, end: point });
          updateSelectionButton();
          setControlStatus("Text selected");
        }
        return;
      }
      movementAtPointerDown = cursorMovementEnabled;
      activePadPointer = event.pointerId;
      pad.setPointerCapture(event.pointerId);
      if (cursorMovementEnabled) {
        queueCursorMove(point);
      }
      setControlStatus(cursorMovementEnabled ? "Moving cursor · release to freeze" : "Cursor frozen · release to resume movement");
    });

    pad.addEventListener("pointermove", (event) => {
      if (selectionMode) {
        if (selectionStart) {
          showSelection(selectionStart, padPoint(event));
        }
        return;
      }
      const dragging = event.pointerId === activePadPointer;
      const hovering = event.pointerType === "mouse" && event.buttons === 0;
      if (!dragging && !hovering) return;
      if (!cursorMovementEnabled) return;

      event.preventDefault();
      const point = padPoint(event);
      queueCursorMove(point);
    });

    function finishPadPointer(event) {
      if (event.pointerId !== activePadPointer) return;
      if (pad.hasPointerCapture(event.pointerId)) {
        pad.releasePointerCapture(event.pointerId);
      }
      activePadPointer = undefined;
      if (movementAtPointerDown !== undefined) {
        cursorMovementEnabled = !movementAtPointerDown;
        updateMovementToggle();
        setControlStatus(cursorMovementEnabled ? "Cursor movement enabled" : "Cursor movement disabled");
        movementAtPointerDown = undefined;
      }
    }

    pad.addEventListener("pointerup", finishPadPointer);
    pad.addEventListener("pointercancel", finishPadPointer);
    pad.addEventListener("contextmenu", (event) => event.preventDefault());
    pad.addEventListener("wheel", (event) => {
      event.preventDefault();
      const amount = event.deltaY < 0 ? 2 : -2;
      controlSend({ type: "wheel", amount });
      setControlStatus(amount > 0 ? "Scrolled up" : "Scrolled down");
    }, { passive: false });

    document.getElementById("leftClick").addEventListener("click", () => {
      controlSend({ type: "click", button: "left" });
      setControlStatus("Left click sent");
    });

    document.getElementById("moveToggle").addEventListener("click", () => {
      cursorMovementEnabled = !cursorMovementEnabled;
      updateMovementToggle();
      setControlStatus(cursorMovementEnabled ? "Cursor movement enabled" : "Cursor movement disabled");
    });

    document.getElementById("rightClick").addEventListener("click", () => {
      controlSend({ type: "click", button: "right" });
      setControlStatus("Right click sent");
    });
    document.getElementById("middleClick").addEventListener("click", () => {
      controlSend({ type: "click", button: "middle" });
      setControlStatus("Middle click sent");
    });
    document.getElementById("wheelUp").addEventListener("click", () => {
      controlSend({ type: "wheel", amount: 3 });
      setControlStatus("Scrolled up");
    });
    document.getElementById("wheelDown").addEventListener("click", () => {
      controlSend({ type: "wheel", amount: -3 });
      setControlStatus("Scrolled down");
    });

    function sendTypedText() {
      const input = document.getElementById("typeText");
      if (!input.value) return;
      controlSend({ type: "type", text: input.value });
      input.value = "";
      setControlStatus("Text sent");
    }
    document.getElementById("selectText").addEventListener("click", () => {
      selectionMode = !selectionMode;
      selectionStart = undefined;
      if (!selectionMode) {
        selectionBox.classList.remove("visible");
        setControlStatus("Selection cancelled");
      } else {
        setControlStatus("Choose the first point on the preview");
      }
      updateSelectionButton();
    });
    document.getElementById("typeText").addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        event.preventDefault();
        sendTypedText();
      }
    });

    for (const button of document.querySelectorAll(".remote-key")) {
      button.addEventListener("click", () => {
        controlSend({ type: "key", key: button.dataset.key });
        setControlStatus(`${button.getAttribute("aria-label") || button.textContent} sent`);
      });
    }
    for (const button of document.querySelectorAll("[data-action-key]")) {
      button.addEventListener("click", () => {
        const key = button.dataset.actionKey;
        controlSend({ type: "key", key });
        setControlStatus(`${button.textContent.trim()} sent`);
      });
    }
    updateFullscreenButton();
    updateSelectionButton();
    connectControl();
  </script>
</body>
</html>
"""


MIC_WORKLET = r"""class MicProcessor extends AudioWorkletProcessor {
  process(inputs) {
    const input = inputs[0];
    if (!input || !input[0]) {
      return true;
    }

    const samples = input[0];
    const pcm = new Int16Array(samples.length);
    for (let i = 0; i < samples.length; i++) {
      const sample = Math.max(-1, Math.min(1, samples[i]));
      pcm[i] = sample < 0 ? sample * 0x8000 : sample * 0x7fff;
    }
    this.port.postMessage(pcm.buffer, [pcm.buffer]);
    return true;
  }
}

registerProcessor("mic-processor", MicProcessor);
"""


SPEAKER_WORKLET = r"""class SpeakerPlayer extends AudioWorkletProcessor {
  constructor() {
    super();
    this.queue = [];
    this.readOffset = 0;
    this.queuedSamples = 0;
    this.started = false;
    this.startSamples = 2048 * 2;
    this.maxSamples = 4800 * 2;
    this.port.onmessage = (event) => {
      const chunk = new Int16Array(event.data);
      this.queue.push(chunk);
      this.queuedSamples += chunk.length;

      if (this.queuedSamples > this.maxSamples) {
        while (this.queue.length > 1 && this.queuedSamples > this.startSamples) {
          const remaining = this.queue[0].length - this.readOffset;
          this.queuedSamples -= remaining;
          this.queue.shift();
          this.readOffset = 0;
        }
      }
    };
  }

  process(_inputs, outputs) {
    const output = outputs[0];
    const left = output[0];
    const right = output[1] || output[0];

    if (!this.started && this.queuedSamples >= this.startSamples) {
      this.started = true;
    }

    for (let i = 0; i < left.length; i++) {
      while (this.queue.length && this.readOffset >= this.queue[0].length) {
        this.queue.shift();
        this.readOffset = 0;
      }
      if (!this.started || !this.queue.length) {
        left[i] = 0;
        right[i] = 0;
        if (!this.queue.length) {
          this.started = false;
        }
        continue;
      }
      const chunk = this.queue[0];
      left[i] = chunk[this.readOffset++] / 32768;
      right[i] = this.readOffset < chunk.length ? chunk[this.readOffset++] / 32768 : left[i];
      this.queuedSamples = Math.max(0, this.queuedSamples - 2);
    }
    return true;
  }
}

registerProcessor("speaker-player", SpeakerPlayer);
"""


class ObsWebSocketError(RuntimeError):
    pass


class ObsScreenshotClient:
    def __init__(self, host, port, password, scene, width, height, quality, max_fps):
        self.host = host
        self.port = port
        self.password = password
        self.scene = scene
        self.width = width
        self.height = height
        self.quality = quality
        self.min_frame_interval = 1.0 / max_fps
        self.lock = threading.Lock()
        self.sock = None
        self.recv_buffer = bytearray()
        self.last_jpeg = None
        self.last_capture = 0.0
        self.last_error = None

    def close(self):
        with self.lock:
            self._disconnect()

    def _disconnect(self):
        sock = self.sock
        self.sock = None
        self.recv_buffer.clear()
        if not sock:
            return
        try:
            sock.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass
        sock.close()

    def _connect(self):
        self._disconnect()
        sock = socket.create_connection((self.host, self.port), timeout=2.0)
        sock.settimeout(2.0)
        self.sock = sock

        key = base64.b64encode(os.urandom(16)).decode("ascii")
        request = (
            "GET / HTTP/1.1\r\n"
            f"Host: {self.host}:{self.port}\r\n"
            "Upgrade: websocket\r\n"
            "Connection: Upgrade\r\n"
            f"Sec-WebSocket-Key: {key}\r\n"
            "Sec-WebSocket-Version: 13\r\n"
            "Sec-WebSocket-Protocol: obswebsocket.json\r\n"
            "\r\n"
        )
        sock.sendall(request.encode("ascii"))

        response = bytearray()
        while b"\r\n\r\n" not in response:
            chunk = sock.recv(4096)
            if not chunk:
                raise ObsWebSocketError("OBS WebSocket closed during HTTP upgrade")
            response.extend(chunk)
            if len(response) > 65536:
                raise ObsWebSocketError("OBS WebSocket sent an oversized HTTP response")

        header, remainder = response.split(b"\r\n\r\n", 1)
        lines = header.decode("iso-8859-1").split("\r\n")
        if not lines or " 101 " not in f" {lines[0]} ":
            raise ObsWebSocketError(f"OBS WebSocket upgrade failed: {lines[0] if lines else 'empty response'}")
        headers = {}
        for line in lines[1:]:
            if ":" in line:
                name, value = line.split(":", 1)
                headers[name.strip().lower()] = value.strip()
        expected_accept = base64.b64encode(
            hashlib.sha1((key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode("ascii")).digest()
        ).decode("ascii")
        if not hmac.compare_digest(headers.get("sec-websocket-accept", ""), expected_accept):
            raise ObsWebSocketError("OBS WebSocket returned an invalid upgrade response")
        self.recv_buffer.extend(remainder)

        hello = self._read_json()
        if hello.get("op") != 0:
            raise ObsWebSocketError("OBS WebSocket did not send Hello")
        hello_data = hello.get("d", {})
        rpc_version = min(1, int(hello_data.get("rpcVersion", 1)))
        identify = {
            "rpcVersion": rpc_version,
            "eventSubscriptions": 0,
        }
        authentication = hello_data.get("authentication")
        if authentication:
            if not self.password:
                raise ObsWebSocketError("OBS WebSocket requires a password")
            salt = str(authentication["salt"])
            challenge = str(authentication["challenge"])
            secret = base64.b64encode(
                hashlib.sha256((self.password + salt).encode("utf-8")).digest()
            ).decode("ascii")
            identify["authentication"] = base64.b64encode(
                hashlib.sha256((secret + challenge).encode("utf-8")).digest()
            ).decode("ascii")
        self._send_json({"op": 1, "d": identify})

        identified = self._read_json()
        if identified.get("op") != 2:
            raise ObsWebSocketError("OBS WebSocket authentication failed")

    def _recv_exact(self, count):
        while len(self.recv_buffer) < count:
            chunk = self.sock.recv(max(4096, count - len(self.recv_buffer)))
            if not chunk:
                raise ObsWebSocketError("OBS WebSocket connection closed")
            self.recv_buffer.extend(chunk)
        data = bytes(self.recv_buffer[:count])
        del self.recv_buffer[:count]
        return data

    def _read_frame(self):
        first, second = self._recv_exact(2)
        final = bool(first & 0x80)
        opcode = first & 0x0F
        masked = bool(second & 0x80)
        length = second & 0x7F
        if length == 126:
            length = struct.unpack("!H", self._recv_exact(2))[0]
        elif length == 127:
            length = struct.unpack("!Q", self._recv_exact(8))[0]
        if length > 16 * 1024 * 1024:
            raise ObsWebSocketError("OBS WebSocket frame is too large")
        mask = self._recv_exact(4) if masked else None
        payload = bytearray(self._recv_exact(length))
        if mask:
            for index in range(length):
                payload[index] ^= mask[index % 4]
        return final, opcode, bytes(payload)

    def _read_message(self):
        message_opcode = None
        chunks = []
        while True:
            final, opcode, payload = self._read_frame()
            if opcode == 0x8:
                raise ObsWebSocketError("OBS WebSocket closed the connection")
            if opcode == 0x9:
                self._send_frame(0xA, payload)
                continue
            if opcode == 0xA:
                continue
            if opcode in (0x1, 0x2):
                if message_opcode is not None:
                    raise ObsWebSocketError("OBS WebSocket started overlapping messages")
                message_opcode = opcode
                chunks.append(payload)
            elif opcode == 0x0:
                if message_opcode is None:
                    raise ObsWebSocketError("OBS WebSocket sent an unexpected continuation")
                chunks.append(payload)
            else:
                raise ObsWebSocketError(f"OBS WebSocket sent unsupported frame opcode {opcode}")
            if final:
                return message_opcode, b"".join(chunks)

    def _send_frame(self, opcode, payload):
        payload = payload or b""
        header = bytearray([0x80 | opcode])
        length = len(payload)
        if length < 126:
            header.append(0x80 | length)
        elif length <= 0xFFFF:
            header.append(0x80 | 126)
            header.extend(struct.pack("!H", length))
        else:
            header.append(0x80 | 127)
            header.extend(struct.pack("!Q", length))
        mask = os.urandom(4)
        header.extend(mask)
        masked_payload = bytes(value ^ mask[index % 4] for index, value in enumerate(payload))
        self.sock.sendall(header + masked_payload)

    def _send_json(self, message):
        payload = json.dumps(message, separators=(",", ":")).encode("utf-8")
        self._send_frame(0x1, payload)

    def _read_json(self):
        opcode, payload = self._read_message()
        if opcode != 0x1:
            raise ObsWebSocketError("OBS WebSocket sent a non-text protocol message")
        return json.loads(payload.decode("utf-8"))

    def _request(self, request_type, request_data):
        request_id = str(uuid.uuid4())
        self._send_json(
            {
                "op": 6,
                "d": {
                    "requestType": request_type,
                    "requestId": request_id,
                    "requestData": request_data,
                },
            }
        )
        while True:
            message = self._read_json()
            if message.get("op") != 7:
                continue
            data = message.get("d", {})
            if data.get("requestId") != request_id:
                continue
            status = data.get("requestStatus", {})
            if not status.get("result"):
                comment = status.get("comment") or f"status code {status.get('code', 'unknown')}"
                raise ObsWebSocketError(f"{request_type} failed: {comment}")
            return data.get("responseData", {})

    def _take_screenshot(self):
        response = self._request(
            "GetSourceScreenshot",
            {
                "sourceName": self.scene,
                "imageFormat": "jpg",
                "imageWidth": self.width,
                "imageHeight": self.height,
                "imageCompressionQuality": self.quality,
            },
        )
        image_data = response.get("imageData", "")
        if not image_data.startswith("data:image/") or "," not in image_data:
            raise ObsWebSocketError("OBS returned invalid screenshot data")
        jpeg = base64.b64decode(image_data.split(",", 1)[1], validate=True)
        if not jpeg.startswith(b"\xff\xd8"):
            raise ObsWebSocketError("OBS did not return a JPEG screenshot")
        return jpeg

    def get_scenes(self):
        with self.lock:
            if self.sock is None:
                self._connect()
            response = self._request("GetSceneList", {})
            scenes = [str(item.get("sceneName", "")) for item in response.get("scenes", [])]
            return {
                "scenes": [name for name in scenes if name],
                "current": self.scene,
            }

    def set_scene(self, scene):
        scene = str(scene)
        with self.lock:
            if self.sock is None:
                self._connect()
            response = self._request("GetSceneList", {})
            scenes = {
                str(item.get("sceneName", ""))
                for item in response.get("scenes", [])
            }
            if scene not in scenes:
                raise ObsWebSocketError(f"OBS scene not found: {scene}")
            self.scene = scene
            self.last_jpeg = None
            self.last_capture = 0.0
        return scene

    def get_jpeg(self):
        with self.lock:
            now = time.monotonic()
            if self.last_jpeg and now - self.last_capture < self.min_frame_interval:
                return self.last_jpeg

            error = None
            for _attempt in range(2):
                try:
                    if self.sock is None:
                        self._connect()
                    capture_started = time.monotonic()
                    jpeg = self._take_screenshot()
                    self.last_jpeg = jpeg
                    self.last_capture = capture_started
                    if self.last_error:
                        print("OBS preview connection recovered", file=sys.stderr)
                    self.last_error = None
                    return jpeg
                except Exception as exc:
                    error = exc
                    self._disconnect()

            message = str(error) if error else "unknown OBS preview error"
            if message != self.last_error:
                print(f"OBS preview unavailable: {message}", file=sys.stderr)
                self.last_error = message
            raise ObsWebSocketError(message)


class RemoteServer(ThreadingHTTPServer):
    def __init__(self, server_address, handler_class, sink, speaker_source, control_token, obs_preview):
        super().__init__(server_address, handler_class)
        self.sink = sink
        self.speaker_source = speaker_source
        self.control_token = control_token
        self.obs_preview = obs_preview
        self.dotool = None
        self.dotool_lock = threading.Lock()
        self.last_dotool_attach_check = 0.0

    def write_dotool(self, command):
        with self.dotool_lock:
            started_dotool = False
            if self.dotool is None or self.dotool.poll() is not None or not self.dotool.stdin:
                self.dotool = subprocess.Popen(["dotool"], stdin=subprocess.PIPE, text=True)
                started_dotool = True

            now = time.monotonic()
            if started_dotool or (
                command.startswith("mouseto ")
                and now - self.last_dotool_attach_check >= 2
            ):
                self.attach_dotool_absolute_pointer()
                self.last_dotool_attach_check = time.monotonic()

            try:
                self.dotool.stdin.write(command)
                self.dotool.stdin.flush()
            except (BrokenPipeError, OSError):
                self.dotool = None
                raise

    def attach_dotool_absolute_pointer(self):
        for _attempt in range(20):
            try:
                result = subprocess.run(
                    [JAY_COMMAND, "--json", "input", "show"],
                    check=True,
                    capture_output=True,
                    text=True,
                    timeout=1,
                )
                state = json.loads(result.stdout)
            except (
                OSError,
                subprocess.SubprocessError,
                json.JSONDecodeError,
            ):
                time.sleep(0.05)
                continue

            for seat in state.get("seats", []):
                if any(
                    device.get("name") == "dotool absolute pointer"
                    for device in seat.get("devices", [])
                ):
                    return

            device = next(
                (
                    candidate
                    for candidate in state.get("detached_devices", [])
                    if candidate.get("name") == "dotool absolute pointer"
                ),
                None,
            )
            if device is None:
                time.sleep(0.05)
                continue

            try:
                subprocess.run(
                    [
                        JAY_COMMAND,
                        "input",
                        "device",
                        str(device["input_device_id"]),
                        "attach",
                        "default",
                    ],
                    check=True,
                    capture_output=True,
                    text=True,
                    timeout=1,
                )
                print(
                    "Attached dotool absolute pointer to Jay seat default",
                    file=sys.stderr,
                )
                return
            except (KeyError, OSError, subprocess.SubprocessError):
                time.sleep(0.05)

        print(
            "Could not attach dotool absolute pointer to Jay seat default",
            file=sys.stderr,
        )

    def server_close(self):
        self.obs_preview.close()
        with self.dotool_lock:
            if self.dotool and self.dotool.poll() is None:
                if self.dotool.stdin:
                    self.dotool.stdin.close()
                self.dotool.terminate()
                try:
                    self.dotool.wait(timeout=2)
                except subprocess.TimeoutExpired:
                    self.dotool.kill()
            self.dotool = None
        super().server_close()


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):
        sys.stderr.write("%s - %s\n" % (self.address_string(), fmt % args))

    def log_request(self, code="-", size="-"):
        if urlsplit(self.path).path == "/obs-preview.jpg":
            return
        super().log_request(code, size)

    def client_is_lan(self):
        try:
            address = ipaddress.ip_address(self.client_address[0].split("%", 1)[0])
        except ValueError:
            return False
        if address.version == 6 and address.ipv4_mapped:
            address = address.ipv4_mapped
        return address.is_loopback or address.is_private or address.is_link_local

    def token_is_valid(self, parsed):
        expected = self.server.control_token
        supplied = parse_qs(parsed.query).get("token", [""])[0]
        return not expected or hmac.compare_digest(supplied, expected)

    def do_GET(self):
        if not self.client_is_lan():
            self.send_error(403, "Chromebook Remote is LAN-only")
            return

        parsed = urlsplit(self.path)
        if parsed.path == "/":
            if self.server.control_token and "token=" not in parsed.query:
                location = f"/?token={self.server.control_token}"
                self.send_response(302)
                self.send_header("Location", location)
                self.send_header("Content-Length", "0")
                self.end_headers()
                return
            self.send_bytes(HTML.encode("utf-8"), "text/html; charset=utf-8")
            return
        if parsed.path == "/mic-worklet.js":
            self.send_bytes(MIC_WORKLET.encode("utf-8"), "text/javascript; charset=utf-8")
            return
        if parsed.path == "/speaker-worklet.js":
            self.send_bytes(SPEAKER_WORKLET.encode("utf-8"), "text/javascript; charset=utf-8")
            return
        if parsed.path == "/obs-preview.jpg":
            if not self.token_is_valid(parsed):
                self.send_error(403, "Bad preview token")
                return
            try:
                jpeg = self.server.obs_preview.get_jpeg()
            except ObsWebSocketError:
                self.send_bytes(b"OBS preview unavailable\n", "text/plain; charset=utf-8", status=503)
                return
            self.send_bytes(jpeg, "image/jpeg")
            return
        if parsed.path == "/obs-scenes":
            if not self.token_is_valid(parsed):
                self.send_error(403, "Bad scene token")
                return
            try:
                self.send_json(self.server.obs_preview.get_scenes())
            except (ObsWebSocketError, OSError) as exc:
                self.send_json({"error": str(exc)}, status=503)
            return
        if parsed.path == "/audio":
            self.websocket_audio()
            self.close_connection = True
            return
        if parsed.path == "/speaker":
            token = parse_qs(parsed.query).get("token", [""])[0]
            self.websocket_speaker(token)
            self.close_connection = True
            return
        if parsed.path == "/control":
            token = parse_qs(parsed.query).get("token", [""])[0]
            self.websocket_control(token)
            self.close_connection = True
            return
        self.send_error(404)

    def do_POST(self):
        if not self.client_is_lan():
            self.send_error(403, "Chromebook Remote is LAN-only")
            return
        parsed = urlsplit(self.path)
        if parsed.path != "/obs-scene":
            self.send_error(404)
            return
        try:
            length = int(self.headers.get("Content-Length", "0"))
            if length > 4096:
                raise ValueError("request too large")
            payload = json.loads(self.rfile.read(length).decode("utf-8"))
            token = str(payload.get("token", ""))
            scene = str(payload.get("scene", "")).strip()
            if self.server.control_token and not hmac.compare_digest(token, self.server.control_token):
                self.send_error(403, "Bad scene token")
                return
            if not scene or len(scene) > 256:
                self.send_error(400, "Invalid scene")
                return
            self.server.obs_preview.set_scene(scene)
            self.send_json({"scene": scene})
        except (ValueError, json.JSONDecodeError) as exc:
            self.send_json({"error": str(exc)}, status=400)
        except (ObsWebSocketError, OSError) as exc:
            self.send_json({"error": str(exc)}, status=503)

    def send_bytes(self, data, content_type, status=200):
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        self.wfile.write(data)

    def send_json(self, payload, status=200):
        self.send_bytes(
            json.dumps(payload, separators=(",", ":")).encode("utf-8"),
            "application/json; charset=utf-8",
            status=status,
        )

    def websocket_audio(self):
        if not self.websocket_accept():
            return

        player = None
        try:
            while True:
                opcode, payload = self.read_frame()
                if opcode is None or opcode == 0x8:
                    break
                if opcode == 0x9:
                    self.write_frame(0xA, payload)
                    continue
                if opcode == 0x1:
                    meta = json.loads(payload.decode("utf-8"))
                    rate = int(meta.get("sampleRate", 48000))
                    player = self.start_player(rate)
                    continue
                if opcode == 0x2 and player and player.stdin:
                    player.stdin.write(payload)
                    player.stdin.flush()
        except (BrokenPipeError, ConnectionError, OSError):
            pass
        finally:
            if player:
                if player.stdin:
                    player.stdin.close()
                player.terminate()
                try:
                    player.wait(timeout=2)
                except subprocess.TimeoutExpired:
                    player.kill()

    def websocket_control(self, token):
        expected = self.server.control_token
        if expected and token != expected:
            self.send_error(403, "Bad remote input token")
            return
        if not self.websocket_accept():
            return

        try:
            while True:
                opcode, payload = self.read_frame()
                if opcode is None or opcode == 0x8:
                    break
                if opcode == 0x9:
                    self.write_frame(0xA, payload)
                    continue
                if opcode == 0x1:
                    message = json.loads(payload.decode("utf-8"))
                    self.handle_control(message)
        except (BrokenPipeError, ConnectionError, OSError, json.JSONDecodeError, ValueError) as exc:
            print(f"Control socket closed: {exc}", file=sys.stderr)

    def websocket_speaker(self, token):
        expected = self.server.control_token
        if expected and token != expected:
            self.send_error(403, "Bad speaker token")
            return
        if not self.websocket_accept():
            return

        recorder = self.start_recorder()
        try:
            while True:
                chunk = recorder.stdout.read(4096)
                if not chunk:
                    break
                self.write_frame(0x2, chunk)
        except (BrokenPipeError, ConnectionError, OSError):
            pass
        finally:
            recorder.terminate()
            try:
                recorder.wait(timeout=2)
            except subprocess.TimeoutExpired:
                recorder.kill()

    def websocket_accept(self):
        key = self.headers.get("Sec-WebSocket-Key")
        if self.headers.get("Upgrade", "").lower() != "websocket" or not key:
            self.send_error(400, "Expected WebSocket upgrade")
            return False

        accept = base64.b64encode(
            hashlib.sha1((key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode()).digest()
        ).decode()
        self.send_response(101, "Switching Protocols")
        self.send_header("Upgrade", "websocket")
        self.send_header("Connection", "Upgrade")
        self.send_header("Sec-WebSocket-Accept", accept)
        self.end_headers()
        self.connection.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        return True

    def handle_control(self, message):
        kind = message.get("type")
        if kind == "move":
            x = max(0.0, min(1.0, float(message["x"])))
            y = max(0.0, min(1.0, float(message["y"])))
            self.run_dotool(f"mouseto {x:.6f} {y:.6f}\n")
            return
        if kind == "select":
            start = message.get("start") or {}
            end = message.get("end") or {}
            start_x = max(0.0, min(1.0, float(start["x"])))
            start_y = max(0.0, min(1.0, float(start["y"])))
            end_x = max(0.0, min(1.0, float(end["x"])))
            end_y = max(0.0, min(1.0, float(end["y"])))
            self.run_dotool(
                "mouseto {:.6f} {:.6f}\n"
                "buttondown left\n"
                "mouseto {:.6f} {:.6f}\n"
                "buttonup left\n".format(start_x, start_y, end_x, end_y)
            )
            return
        if kind == "click":
            button = message.get("button", "left")
            if button not in {"left", "middle", "right"}:
                raise ValueError("bad button")
            print(f"Remote input: click {button}", file=sys.stderr)
            self.run_dotool(f"buttondown {button}\nbuttonup {button}\n")
            return
        if kind == "wheel":
            amount = max(-8, min(8, int(message.get("amount", 0))))
            if amount:
                self.run_dotool(f"wheel {amount}\n")
            return
        if kind == "key":
            key = str(message.get("key", ""))
            if not re.fullmatch(r"[a-z0-9_+-]{1,32}", key):
                raise ValueError("bad key")
            key_aliases = {
                "super": "leftmeta",
                "meta": "leftmeta",
                "ctrl": "leftctrl",
                "control": "leftctrl",
                "shift": "leftshift",
                "alt": "leftalt",
            }
            parts = key.split("+")
            if len(parts) == 1:
                self.run_dotool(f"key {key_aliases.get(key, key)}\n")
            else:
                modifiers = [key_aliases.get(part, part) for part in parts[:-1]]
                main_key = key_aliases.get(parts[-1], parts[-1])
                commands = [f"keydown {modifier}" for modifier in modifiers]
                commands.append(f"key {main_key}")
                commands.extend(f"keyup {modifier}" for modifier in reversed(modifiers))
                self.run_dotool("\n".join(commands) + "\n")
            return
        if kind == "type":
            text = str(message.get("text", ""))[:300]
            text = text.replace("\r", " ").replace("\n", " ")
            if text:
                self.run_dotool(f"type {text}\n")
            return
        raise ValueError("bad control message")

    def run_dotool(self, command):
        self.server.write_dotool(command)

    def start_recorder(self):
        source = self.server.speaker_source
        print(f"Streaming PC audio from {source} to browser", file=sys.stderr)
        if shutil.which("parec"):
            return subprocess.Popen(
                [
                    "parec",
                    "--record",
                    "--raw",
                    "--device",
                    source,
                    "--rate",
                    "48000",
                    "--channels",
                    "2",
                    "--format",
                    "s16le",
                    "--latency-msec",
                    "20",
                    "--process-time-msec",
                    "10",
                    "--client-name",
                    "Chromebook Remote",
                    "--stream-name",
                    "PC audio to Chromebook",
                ],
                stdout=subprocess.PIPE,
                bufsize=0,
            )
        return subprocess.Popen(
            [
                "pw-cat",
                "--record",
                "--raw",
                "--target",
                source,
                "--rate",
                "48000",
                "--channels",
                "2",
                "--format",
                "s16",
                "-",
            ],
            stdout=subprocess.PIPE,
            bufsize=0,
        )

    def read_exact(self, count):
        data = self.rfile.read(count)
        if len(data) != count:
            raise ConnectionError("short read")
        return data

    def read_frame(self):
        header = self.rfile.read(2)
        if not header:
            return None, b""
        if len(header) != 2:
            raise ConnectionError("short frame header")

        b1, b2 = header
        opcode = b1 & 0x0F
        masked = b2 & 0x80
        length = b2 & 0x7F
        if length == 126:
            length = struct.unpack("!H", self.read_exact(2))[0]
        elif length == 127:
            length = struct.unpack("!Q", self.read_exact(8))[0]

        mask = self.read_exact(4) if masked else b"\0\0\0\0"
        payload = bytearray(self.read_exact(length))
        if masked:
            for i in range(length):
                payload[i] ^= mask[i % 4]
        return opcode, bytes(payload)

    def write_frame(self, opcode, payload):
        payload = payload or b""
        header = bytearray([0x80 | opcode])
        length = len(payload)
        if length < 126:
            header.append(length)
        elif length <= 0xFFFF:
            header.append(126)
            header.extend(struct.pack("!H", length))
        else:
            header.append(127)
            header.extend(struct.pack("!Q", length))
        self.wfile.write(header + payload)
        self.wfile.flush()

    def start_player(self, rate):
        sink = self.server.sink
        print(f"Streaming browser mic to {sink} at {rate} Hz", file=sys.stderr)
        return subprocess.Popen(
            [
                "pw-cat",
                "--playback",
                "--raw",
                "--target",
                sink,
                "--rate",
                str(rate),
                "--channels",
                "1",
                "--format",
                "s16",
                "--latency",
                "20ms",
                "-",
            ],
            stdin=subprocess.PIPE,
            bufsize=0,
        )


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=8765)
    parser.add_argument("--sink", default=os.environ.get("CHROMEBOOK_MIC_INTERMEDIATE_SINK", "Intermediate-Chromebook-Mic"))
    parser.add_argument("--speaker-source", default=os.environ.get("LAPTOP_SPEAKER_SOURCE", "Laptop-Speaker.monitor"))
    parser.add_argument("--tls-cert")
    parser.add_argument("--tls-key")
    parser.add_argument("--control-token", default=os.environ.get("CHROMEBOOK_REMOTE_TOKEN", ""))
    parser.add_argument(
        "--obs-websocket-config",
        default=os.path.expanduser("~/.config/obs-studio/plugin_config/obs-websocket/config.json"),
    )
    parser.add_argument("--obs-websocket-host", default="127.0.0.1")
    parser.add_argument("--obs-websocket-port", type=int)
    parser.add_argument("--obs-websocket-password")
    parser.add_argument("--obs-scene", default=os.environ.get("OBS_PREVIEW_SCENE", "where its at"))
    parser.add_argument("--preview-width", type=int, default=960)
    parser.add_argument("--preview-height", type=int, default=540)
    parser.add_argument("--preview-quality", type=int, default=50)
    parser.add_argument("--preview-fps", type=float, default=20.0)
    args = parser.parse_args()

    os.environ.setdefault("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")

    if not shutil.which("pw-cat"):
        print("Missing required command: pw-cat", file=sys.stderr)
        return 1

    if not shutil.which("dotool"):
        print("Missing required command: dotool", file=sys.stderr)
        return 1

    if args.preview_width < 8 or args.preview_width > 4096:
        print("--preview-width must be between 8 and 4096", file=sys.stderr)
        return 2
    if args.preview_height < 8 or args.preview_height > 4096:
        print("--preview-height must be between 8 and 4096", file=sys.stderr)
        return 2
    if args.preview_quality < 0 or args.preview_quality > 100:
        print("--preview-quality must be between 0 and 100", file=sys.stderr)
        return 2
    if args.preview_fps <= 0 or args.preview_fps > 30:
        print("--preview-fps must be greater than 0 and no more than 30", file=sys.stderr)
        return 2

    obs_config = {}
    if args.obs_websocket_config:
        try:
            with open(args.obs_websocket_config, encoding="utf-8") as config_file:
                obs_config = json.load(config_file)
        except FileNotFoundError:
            pass
        except (OSError, json.JSONDecodeError) as exc:
            print(f"Could not read OBS WebSocket config: {exc}", file=sys.stderr)
            return 2
    obs_port = args.obs_websocket_port or int(obs_config.get("server_port", 4455))
    obs_password = (
        args.obs_websocket_password
        if args.obs_websocket_password is not None
        else str(obs_config.get("server_password", ""))
    )
    obs_preview = ObsScreenshotClient(
        args.obs_websocket_host,
        obs_port,
        obs_password,
        args.obs_scene,
        args.preview_width,
        args.preview_height,
        args.preview_quality,
        args.preview_fps,
    )

    server = RemoteServer(
        (args.host, args.port),
        Handler,
        args.sink,
        args.speaker_source,
        args.control_token,
        obs_preview,
    )
    scheme = "http"
    if args.tls_cert or args.tls_key:
        if not args.tls_cert or not args.tls_key:
            print("--tls-cert and --tls-key must be used together", file=sys.stderr)
            return 2
        context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        context.load_cert_chain(args.tls_cert, args.tls_key)
        server.socket = context.wrap_socket(server.socket, server_side=True)
        scheme = "https"

    print(f"Listening on {scheme}://{args.host}:{args.port}", file=sys.stderr)
    print(f"Mic intermediate sink: {args.sink}", file=sys.stderr)
    print(f"Laptop speaker source: {args.speaker_source}", file=sys.stderr)
    print(
        f"OBS preview: {args.obs_scene} via {args.obs_websocket_host}:{obs_port} "
        f"at {args.preview_width}x{args.preview_height}, up to {args.preview_fps:g} fps",
        file=sys.stderr,
    )
    if args.control_token:
        print("Remote input token is enabled", file=sys.stderr)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
