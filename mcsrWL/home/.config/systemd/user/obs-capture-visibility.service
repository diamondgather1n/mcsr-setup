[Unit]
Description=Show the visible Minecraft capture in OBS
After=default.target obs-input-overlay.service

[Service]
Type=simple
ExecStart=/home/nathan/.local/bin/obs-capture-visibility
Restart=always
RestartSec=1
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=default.target
