[Unit]
Description=Expose the wired headset microphone as HeadPhones-Mic
After=pipewire.service pipewire-pulse.service
Wants=pipewire.service pipewire-pulse.service

[Service]
Type=simple
ExecStart=%h/.local/bin/headphones-mic-setup
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
