# semi working i3 config

set $mod Mod4

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

font pango:monospace 8

# thin/borderless window borders
default_border normal 1
default_floating_border normal 1
floating_modifier $mod
tiling_drag modifier titlebar
focus_follows_mouse no

