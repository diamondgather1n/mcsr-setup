#!/bin/sh
state="/tmp/i3bar-cpu-$USER"
read _ user nice system idle iowait irq softirq steal _ < /proc/stat
idle_all=$((idle + iowait))
total=$((user + nice + system + idle + iowait + irq + softirq + steal))

if [ -f "$state" ]; then
    read old_total old_idle < "$state"
    total_diff=$((total - old_total))
    idle_diff=$((idle_all - old_idle))
    if [ "$total_diff" -gt 0 ]; then
        usage=$((100 * (total_diff - idle_diff) / total_diff))
        printf "%4s\n" "${usage}%"
    else
        printf "%4s\n" "0%"
    fi
else
    printf "%4s\n" "..."
fi

echo "$total $idle_all" > "$state"
