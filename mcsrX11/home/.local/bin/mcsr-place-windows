#!/bin/sh

# Repeat because Java/Minecraft windows can resize after opening.
for delay in 0.1 0.4 0.9 1.6 2.5; do
    sleep "$delay"

    i3-msg '[class="^ninjabrainbot-Main$"] move container to workspace number 7, floating enable, border normal 0, resize set 420 236, move absolute position 1500 0'

    i3-msg '[title="^Minecraft\* 1\.16\.1 - MCSR Ranked$"] move container to workspace number 7, floating enable, border normal 0, resize set 320 1080, move absolute position 800 0'
done
