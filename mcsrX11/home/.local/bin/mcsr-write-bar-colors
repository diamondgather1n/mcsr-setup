#!/usr/bin/env bash
STATE="$HOME/.cache/mcsr-speedrun-mode"
CONF="$HOME/.config/i3/config"

mode="normal"
[ -f "$STATE" ] && mode="$(cat "$STATE" 2>/dev/null || echo normal)"

if [ "$mode" = "speedrun" ]; then
    bg="#7a0000"
    focus="#c51015"
    border="#ff5555"
    text="#fff0f0"
    sep="#9a3030"
else
    bg="#061426"
    focus="#0b315e"
    border="#3388cc"
    text="#e8f3ff"
    sep="#2b5d82"
fi

python - "$CONF" "$bg" "$focus" "$border" "$text" "$sep" <<'PY'
from pathlib import Path
import re
import sys

p = Path(sys.argv[1])
bg, focus, border, text_color, sep = sys.argv[2:7]
text = p.read_text()

block = f'''        # MCSR-BAR-COLORS-START
        colors {{
            background {bg}
            statusline #ffffff
            separator {sep}

            focused_workspace #ffcc33 {focus} #ffffff
            active_workspace {border} {bg} {text_color}
            inactive_workspace {border} {bg} {text_color}
            urgent_workspace #ff4444 #5a0000 #ffffff
            binding_mode {border} {bg} {text_color}
        }}
        # MCSR-BAR-COLORS-END
'''

text = re.sub(
    r'        # MCSR-BAR-COLORS-START\n.*?        # MCSR-BAR-COLORS-END\n',
    block,
    text,
    count=1,
    flags=re.S
)

p.write_text(text)
PY
