separator=true
separator_block_width=15

[input-recording]
command=~/.local/bin/input-recorder indicator
interval=1

[california-time]
label=CA 
command=TZ=America/Los_Angeles date '+%H:%M'
interval=1
color=#66dd88

[north-carolina-time]
label=NC 
command=TZ=America/New_York date '+%H:%M'
interval=1
color=#66dd88

[time]
command=date '+%H:%M'
interval=1
color=#ffff66

[date]
command=date '+%a %d %b'
interval=30
color=#ff9900

[cpu]
label=CPU 
command=~/.local/bin/bar-cpu
interval=1
color=#ff4444

[gpu]
label=GPU 
command=~/.local/bin/bar-gpu
interval=1
color=#ff4444

[ram]
label=RAM 
command=free -m | awk '/Mem:/ {printf "%4.1f/%4.1fG\n", $3/1024, $2/1024}'
interval=2
color=#ff4444

[disk]
label=DISK 
command=df -h / | awk 'NR==2 {printf "%8s free\n", $4}'
interval=30
color=#ffffff

[net]
label=NET 
command=~/.local/bin/bar-net
interval=1
color=#ffffff

[volume]
label=VOL 
command=~/.local/bin/bar-volume
interval=1
color=#ffffff
