# semi working i3 config

set $mod Mod4

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

font pango:monospace 8
floating_modifier $mod
tiling_drag modifier titlebar
focus_follows_mouse no

# Mode settings

exec --no-startup-id /home/nathan/MCSR/x11/shell-scripts/less.sh

bindcode --release 117 exec --no-startup-id "$HOME/MCSR/x11/shell-scripts/norwegian.sh", mode "speedrun"

mode "speedrun" {
    bindcode 191 exec --no-startup-id "$HOME/MCSR/x11/macros/thin.sh"
    bindcode 193 exec --no-startup-id "$HOME/MCSR/x11/macros/wide.sh"
    bindcode 194 exec --no-startup-id "$HOME/MCSR/x11/macros/DPIlessZoom.sh"
    bindcode 192 exec --no-startup-id "$HOME/MCSR/x11/macros/zoom.sh"

    bindcode --release 117 exec --no-startup-id "$HOME/MCSR/x11/shell-scripts/british.sh", mode "default"
}

# Window sorting rules

for_window [title="(?i).*ninjabrain.*"] move container to workspace number 7
for_window [title="(?i).*ninjabrain.*"] floating enable, border pixel 0, resize set 420 236, move absolute position 1500 50

for_window [title="(?i).*minecraft.*1\.16\.1.*"] move container to workspace number 7
for_window [title="(?i).*minecraft.*1\.16\.1.*"] floating enable, border pixel 0, move absolute position 800 -20

for_window [title="(?i)2adhd1 - Chat - Twitch"] move container to workspace number 2
for_window [title="(?i)Activity Feed - Twitch"] move container to workspace number 2
for_window [title="(?i)Quick Actions - Twitch"] move container to workspace number 2

for_window [class="Helium"] move container to workspace number 6
for_window [title="(?i)projector"] move container to workspace number 7
for_window [title="(?i)AutoKey"] move container to workspace number 10
for_window [class="qpwgraph"] move container to workspace number 10
for_window [class="konsole"] move container to workspace number 10

assign [class="obs"] $ws9
assign [class="discord"] $ws1
assign [class="kdenlive"] $ws3
assign [class="PrismLauncher"] $ws5
assign [class="Spotify"] $ws8

# Keybinds

bindsym $mod+Shift+space floating toggle
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Return exec konsole

# Not sure what this is but it was in the defualt i3 config

set $refresh_i3status killall -SIGUSR1 i3status

bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status

# Default binds in case of emergency

bindsym $mod+d exec --no-startup-id dmenu_run
bindsym $mod+Shift+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10



# Startup commands

exec --no-startup-id systemctl --user import-environment DISPLAY XAUTHORITY DBUS_SESSION_BUS_ADDRESS XDG_CURRENT_DESKTOP
exec --no-startup-id dbus-update-activation-environment --systemd DISPLAY XAUTHORITY DBUS_SESSION_BUS_ADDRESS XDG_CURRENT_DESKTOP=i3
exec --no-startup-id dex --autostart --environment i3
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork
exec --no-startup-id nm-applet
exec --no-startup-id xset r rate 150 200
exec --no-startup-id xfce4-panel
exec --no-startup-id feh --bg-fill '/home/nathan/MCSR/CrossDisplayManager/obs images/background.jpg'
exec --no-startup-id xset dpms 3600 3600 3600
